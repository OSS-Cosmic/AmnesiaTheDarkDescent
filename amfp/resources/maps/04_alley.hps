void StrobeTimer (string &in asTimer)
{
	if (asTimer == "StrobeLightsOn") 
	{
		SetLanternFlickerActive(false);
		PlaySoundAtEntity("cellar_gaslamp01_short_1_flicker", "cellar_light_flicker_louder.snt", "cellar_gaslamp01_short_1", 1.0f, false);
		SetLightVisible("PointLight_160", true);
		SetLampLit("cellar_gaslamp01_short_1", true, false);
		SetLampLit("cellar_gaslamp01_F_long_25", true, false);
		SetLampLit("cellar_gaslamp01_F_long_2", true, false);
		SetLampLit("sewer_wall_lamp_2", true, true);
		SetLampLit("sewer_wall_lamp_3", true, true);
		SetLampLit("sewer_wall_lamp_4", true, true);
		SetLampLit("sewer_lights_2", true, true);
		SetLampLit("sewer_lights_4", true, true);
		SetLampLit("sewer_lights_5", true, true);
		AddTimer("StrobeLightsOff", RandFloat(0.03f, 0.2f), "StrobeTimer"); //Strobe - amount of time lights are on for
	}
		
	if (asTimer == "StrobeLightsOff")
	{
		SetLightVisible("PointLight_160", false);
		SetLampLit("cellar_gaslamp01_short_1", false, false);
		SetLampLit("cellar_gaslamp01_F_long_25", false, false);
		SetLampLit("cellar_gaslamp01_F_long_2", false, false);
		SetLampLit("sewer_wall_lamp_2", false, false);
		SetLampLit("sewer_wall_lamp_3", false, false);
		SetLampLit("sewer_wall_lamp_4", false, false);
		SetLampLit("sewer_lights_2", false, false);
		SetLampLit("sewer_lights_4", false, false);
		SetLampLit("sewer_lights_5", false, false);
		SetLanternFlickerActive(true);
		AddTimer("StrobeLightsOn", RandFloat(0.3f, 0.9f), "StrobeTimer"); //Strobe - amount of time lights are off for
	}
}

void Conveyor_Cage_2_Lantern (string &in asParent, string &in asChild, int alState) //LanternLight Flicker
{
	if (alState == 1)
	{
		AddTimer("StrobeLightsOff", RandFloat(0.01f, 0.35f), "StrobeTimer");
		AddDebugMessage("COnveyor_Lightflicker", false);
		return;
	}
	else if (alState == -1) 
	{
		AddDebugMessage("End conveyor_lightflicker", false);
		RemoveTimer("StrobeLightsOn");
		RemoveTimer("StrobeLightsOff");
		RemoveTimer("StrobeHandler");
		RemoveTimer("ConveyorLoop*");
		SetLightVisible("PointLight_160", true);
		SetLanternFlickerActive(false);
		SetLampLit("cellar_gaslamp01_short_1", true, true);
		SetLampLit("cellar_gaslamp01_F_long_2", true, true);
		SetLampLit("sewer_wall_lamp_2", true, true);
		SetLampLit("sewer_wall_lamp_3", true, true);
		SetLampLit("sewer_wall_lamp_4", true, true);
		SetLampLit("sewer_lights_2", true, true);
		SetLampLit("sewer_lights_4", true, true);
		SetLampLit("sewer_lights_5", true, true);
		SetEntityActive(asChild, false);
		return;
	}
}

