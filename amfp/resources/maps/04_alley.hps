//---------------------------
//PUMP CANISTER HANDLER//
//---------------------------

//--------------------------------------------

void PumpCanisterHandler (string &in asParent, string &in asChild, int alState)
{
	if (asChild == "PumpCollider" && alState == 1 && GetPropIsInteractedWith(asParent) == true)
	{
		AddDebugMessage("Canister Fitted to Pump", false);
		RemoveEntityCollideCallback("CanisterEmpty_*", "PumpCollider");
		SetEntityActive(asParent, false);
		SetEntityActive("CanisterFull_1", true);
		SetEntityInteractionDisabled("CanisterFull_1", true);
		SetPropStaticPhysics("CanisterFull_1", true);
		SetWheelStuckState("PumpValve", 0, false);
		PlaySoundAtEntity("", "alley_cannister_onto_pump.snt", "PumpCollider", 0.0f, false);
		StopMusic(5.0f, 3);
		return;
	}
}

//--------------------------------------------

void UpdateFuelCanisterState ()
{
	if (GetLocalVarInt("PumpFuelLevel") == 0)
	{
		SetEntityInteractionDisabled("CanisterFull_1", false);
		SetPropStaticPhysics("CanisterFull_1", false);
		
		SetWheelStuckState("PumpValve", 1, false);
		PlaySoundAtEntity("", "alley_fuel_pump_complete.snt", "PumpCollider", 0.0f, false);
		PlayMusic("music_bath_spin_sting_24.ogg", false, 0.7, 0.2, 10, false);
	}
}

//--------------------------------------------

//---------------------------
//END PUMP CANISTER HANDLER//
//---------------------------

//---------------------------
//PUMP VALVE HANDLER//
//---------------------------

//--------------------------------------------

void PumpValveHandler (string &in asParent, string &in asChild, int alState)
{
	AddDebugMessage("Valve "+asParent+" vs "+asChild+": "+alState, false);

	if (asChild == "PumpValveTriggerDisableTop")
	{
		SetLocalVarInt("PumpValveTopDisabled", 1);
		SetLocalVarInt("PumpValveBottomDisabled", 0);
		return;
	}
	else if (asChild == "PumpValveTriggerDisableBottom")
	{
		SetLocalVarInt("PumpValveBottomDisabled", 1);
		SetLocalVarInt("PumpValveTopDisabled", 0);
		return;
	}
	else if (asChild == "PumpValveColliderBottom" && GetLocalVarInt("PumpValveBottomDisabled") == 0)
	{
		if (GetLocalVarInt("PumpFuelLevel") == 8)
		{
			SetLocalVarInt("PumpFuelLevel", 7);
			PlayPropAnimation("fuel_pump_1", "fulltoseven", 0.0f, false, "");
			return;
		}
		else if (GetLocalVarInt("PumpFuelLevel") == 6)
		{
			SetLocalVarInt("PumpFuelLevel", 5);
			PlayPropAnimation("fuel_pump_1", "sixtofive", 0.0f, false, "");
			return;
		}
		else if (GetLocalVarInt("PumpFuelLevel") == 4)
		{
			SetLocalVarInt("PumpFuelLevel", 3);
			PlayPropAnimation("fuel_pump_1", "fourtothree", 0.0f, false, "");
			return;
		}
		else if (GetLocalVarInt("PumpFuelLevel") == 2)
		{
			SetLocalVarInt("PumpFuelLevel", 1);
			PlayPropAnimation("fuel_pump_1", "twotoone", 0.0f, false, "");
			return;
		}
	}
	
	else if (asChild == "PumpValveColliderTop" && GetLocalVarInt("PumpValveTopDisabled") == 0)
	{
		if (GetLocalVarInt("PumpFuelLevel") == 7)
		{
			SetLocalVarInt("PumpFuelLevel", 6);
			PlayPropAnimation("fuel_pump_1", "seventosix", 0.0f, false, "");
			return;
		}
		else if (GetLocalVarInt("PumpFuelLevel") == 5)
		{
			SetLocalVarInt("PumpFuelLevel", 4);
			WalkwayPigEventInit();
			PlayPropAnimation("fuel_pump_1", "fivetofour", 0.0f, false, "");
			return;
		}
		else if (GetLocalVarInt("PumpFuelLevel") == 3)
		{
			SetLocalVarInt("PumpFuelLevel", 2);
			PlayPropAnimation("fuel_pump_1", "threetotwo", 0.0f, false, "");
			return;
		}
		else if (GetLocalVarInt("PumpFuelLevel") == 1)
		{
			SetLocalVarInt("PumpFuelLevel", 0);
			PlayPropAnimation("fuel_pump_1", "ontoempty", 0.0f, false, "");
			SetEntityActive("Mask2A", false);
			SetEntityActive("Mask2B", true);
			SetLocalVarInt("Mask2AActive", 0);
			SetLocalVarInt("Mask2BActive", 1);
			UpdateFuelCanisterState();
			return;
		}
	}
}
//--------------------------------------------

//--------------------------
//END PUMP VALVE HANDLER//
//--------------------------

//FULL CANISTER SOUNDS//
void FullCanisterSounds (string &in asEntity)
{
	AddDebugMessage("CanisterSoundSource = "+asEntity, false);
	SetLocalVarString("CanisterSoundSource", asEntity);
	AddTimer("FullCanisterSoundPlayer", 1.0f, "FullCanisterSoundPlayer");
}

void FullCanisterSoundPlayer (string &in asTimer)
{
	if (GetPlayerSpeed() > 0.0f)
	{
		AddDebugMessage("Slosh Sound", false);
		PlaySoundAtEntity("", "alley_cannister_slosh.snt", GetLocalVarString("CanisterSoundSource"), 0.0f, false);
	}
	if (GetPropIsInteractedWith(GetLocalVarString("CanisterSoundSource")) == true)
	{
		AddDebugMessage("New Timer Initialised", false);
		AddTimer(asTimer, RandFloat(1.4f, 2.0f), "FullCanisterSoundPlayer");
	}
	else
	{
		AddDebugMessage("No Interaction Detected, Timer Loop Stopped", false);
	}
}
//END FULL CANISTER SOUNDS//

//TRUCK CANISTER HANDLER//
void TruckCanisterHandler (string &in asParent, string &in asChild, int alState)
{
	if (asChild == "TruckCollider" && alState == 1 && GetPropIsInteractedWith(asParent) == true)
	{
		AddDebugMessage("Canister Fitted to Truck", false);
		RemoveEntityCollideCallback("CanisterEmpty_*", "PumpCollider");
		AddAttachedPropToProp("TruckBackfire", "TruckBackfireCanister", "fuel_canister_full.ent", -0.65f, -0.6f, -2.75f, 0.0f, 180.0f, 0.0f);
		SetLocalVarInt("FuelFittedToTruck", 1);
		SetWheelInteractionDisablesStuck("TruckBackfireHandleInit", true);
		SetEntityActive(asParent, false);
		PlaySoundAtEntity("", "alley_cannister_into_veh.snt", "TruckCollider", 0.0f, false);
		return;
	}
}
//END TRUCK CANISTER HANDLER//

//TRUCK BACKFIRE EVENT//
void TruckBackfireEvent (string &in asEntity, int alState)
{
	if (alState == 1 && GetLocalVarInt("FuelFittedToTruck") == 1)
	{
		SetEntityActive("block_box_59", false);
		SetEntityActive("block_box_60", false);
		SetEntityActive("Mask2B", false);
		SetLocalVarInt("Mask2BActive", 0);
		SetPropStaticPhysics("TruckBackfire", false);
		SetLampLit("TruckBackfireLights", true, false);
		AddTimer("TruckLightTimer1", 1.7f, "BackfireTimers");
		//AddTimer("TruckLightTimer2", 10.0f, "BackfireTimers"); 
		//AddTimer("TruckLightTimer3", 18.5f, "BackfireTimers");
		SetEntityActive("TruckBackfireHandleInit", false);
		AddAttachedPropToProp("TruckBackfire", "TruckBackfireHandle", "truck_crankshafthandle.ent", 0.0f, -1.8f, -5.0f, 0.0f, 0.0f, 0.0f);
		AddPropForce("TruckBackfire", 0.0f, 0.0f, 3000.0f, "local");
		PlaySoundAtEntity("Backfire", "afx_church_backfire.snt", "TruckEngineSource", 0.0f, false);
		PlaySoundAtEntity("Engine", "afx_church_engine.snt", "TruckEngineSource", 0.0f, false);
		PlaySoundAtEntity("Crows", "afx_church_engine_crows.snt", "TruckCrowSource", 0.0f, false);
		SetParticleSystemActive("TruckBackfire1", true);
		SetParticleSystemActive("TruckBackfire2", true);
	}
	else if (alState == 1 && GetLocalVarInt("FuelFittedToTruck") == 0)
	{
		PlaySoundAtEntity("Backfire", "afx_church_engine_nofuel.snt", "TruckEngineSource", 0.0f, false);
		SetWheelStuckState(asEntity, -1, false);
		SetWheelInteractionDisablesStuck(asEntity, true);
	}
		
}

void BackfireTimers (string &in asTimer)
{
	if (asTimer == "TruckLightTimer1")
	{
		SetLampFlickerActive("TruckBackfireLights", false);
		SetLampLit("TruckBackfireLights", false, false);
		SetLampLit("TruckBackfireLights", true, false);
		SetPropStaticPhysics("TruckBackfire", true);
		return;
	}
	else if (asTimer == "TruckLightTimer2")
	{
		FadeLampTo("TruckBackfireLights", 0, 0, 0, 0, -1, 8.0);
		return;
	}
	else if (asTimer == "TimerLightTimer3")
	{
		SetLampLit("TruckBackfireLights", false, false);
		return;
	}
}
//END BACKFIRE EVENT//

