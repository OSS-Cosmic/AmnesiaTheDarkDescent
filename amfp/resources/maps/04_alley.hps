// HINT HANDLER//
void HintHandler (string &in asParent, string &in asChild, int alState)
{
	if (asChild == "EnteredOfficesTrigger")
	{
		AddHint("Alley1", "");
		return;
	}
	else if (asChild == "PumpPlayerTracker")
	{
		AddHint("Alley2", "");
		return;
	}
	else if (asChild == "CarHintTrigger")
	{
		AddHint("Alley3", "");
		return;
	}
}
//END HINT HANDLER//

//DELAYED HINT//
void TimerDelayedHint(string &in asEntity)
{
	AddHint(asEntity, "");
}
//END DELAYED HINT//
