//HITCHCOCK ZOOM//
void DoHitchcockZoom(string &in asParent, string &in asChild, int alState) //Hitchcock zoom effect
{
	AddDebugMessage("Ohhhh here it goes!", false);
	PlaySoundAtEntity("", "afx_gameplay_hightone_10sec.snt", "Player", 1.0f, false);
	RemoveEntityCollideCallback("spectacles_*", "HitchcockCollisionDetector");
	RemoveEntityCollideCallback("false_teeth_*", "HitchcockCollisionDetector");
	PlaySoundAtEntity("HitchcockZoomSound", "afx_drawer_open_teeth.snt", "Player", 0.0f, false);
	StartPlayerLookAt("HitchcockLookTarget", 20.0f, 20.0f,"");
	SetPlayerActive(false);
	StopPlayerLookAt();
	FadePlayerFOVMulTo(0.6f, 1.0f);
	MovePlayerHeadPos (0.0f, 1.5f, -1.0f, 0.5f, 0.4f);
	AddTimer("hitchcocktimer", 3.0f, "Hitchcocktimer");
	FadeSepiaColorTo(1.0f, 0.5f);
}

void Hitchcocktimer (string &in asTimer)
{
	AddDebugMessage("Ouch ma teef!", false);
	FadePlayerFOVMulTo(1.0f, 2.0f);
	MovePlayerHeadPos(0.0f, 0.0f, 0.0f, 2.0f, 0.5f);
	SetPlayerActive(true);
	MandusReactionPlayer("Breath", 0.25f);
	FadeSepiaColorTo(0.0f, 0.5f);
	return;
}
//END HITCHCOCK ZOOM//

//MUSIC STOP OFFICES//
void MusicStopTriggerOffices (string &in asParent, string &in asChild, int alState)
{
	StopMusic(5.0f, 2);
	StopMusic(5.0f, 1);
	StopMusic(5.0f, 0);
	StopMusic(5.0f, 3);
}
//END MUSIC STOP OFFICES//
			
//CRATE INTERACTION UPDATE//
void CrateInteractionUpdater (string &in asParent, string &in asChild, int alState)
{
	if (asChild == "CrateInteractionOffTrigger")
	{
		SetPropStaticPhysics ("BlockingCrate", true);
		SetEntityInteractionDisabled("BlockingCrate", true);
		SetLightVisible("SpotLight_31", true);
		return;
	}
	else if (asChild == "CrateInteractionOnTrigger")
	{
		SetPropStaticPhysics ("BlockingCrate", false);
		SetEntityInteractionDisabled("BlockingCrate", false);
		SetLightVisible("SpotLight_31", false);
		return;
	}
}
//END CRATE INTERACTION UPDATE//
			
//WALKWAY PIG EVENT//
void WalkwayPigEventInit ()
{
	//PlaySoundAtEntity("", "", "WalkwayPig", 0.0f, false);
	PlaySoundAtEntity("", "afx_church_wretch_factory_scream_2D", "WalkwayPig", 0.0f, false);
	MandusReactionPlayer("Quick", 1.5f);
	MandusReactionPlayer("Scared", 3.7f);
	PlaySoundAtEntity("", "afx_church_wretch_factory_scream_3D", "WalkwayPig", 0.0f, false);
	PlaySoundAtEntity("", "afx_church_wretch_factory_door_smash_2D", "DoorSmashSoundArea", 0.0f, false);
	PlaySoundAtEntity("", "afx_church_wretch_factory_door_smash_3D", "DoorSmashSoundArea", 0.0f, false);
	PlaySoundAtEntity("PigSweet", "afx_alley_pigsweetener.snt", "PigDustTrigger4", 3.0f, false);
	SetEnemyDisableTriggers("WalkwayPig", true);
	AddTimer("PigBangDoorTimer", 16.0f, "WretchFactoryEventPart2");
	AddTimer("PigBangDoorTimer2", 16.0f, "WretchFactoryEventPart2_2");
	AddTimer("FactoryMusic", 1.2f, "FactoryMusic");
	SetEntityActive("WalkwayPig", true);
	AddEnemyPatrolNode("WalkwayPig", "PathNodeArea_24", 1.5f, "", false);
	
	StopMusic(0.2f, 2);	
	StopMusic(0.2f, 3);	
}

void FactoryMusic (string &in asTimer)
{
	AddDebugMessage("Function: 'FactoryMusic' - Triggered Successfully", false);
	PlayMusic("music_church_factory_pig.ogg", false, 0.7f, 0.7f, 4, false);
	FadeImageTrailTo(0.5f, 0.2f);
	StartScreenShake(0.05f, 1.5f, 0.1f, 0.1f);
	FadeSepiaColorTo(0.5f, 0.2f);
	AddTimer ("EndVisEffect", 1.2f, "RestoreToNormal");
}

void WalkwayPigDustDrops (string &in asParent, string &in asChild, int alState)
{
	switch (GetLocalVarInt("pigfeetduststeptracker"))
	{
		case 0:
		SetParticleSystemActive("PigFeetDusta_*", true);
		SetLocalVarInt("pigfeetduststeptracker", 1);
		break;
		
		case 1:
		SetParticleSystemActive("PigFeetDustb_*", true);
		SetLocalVarInt("pigfeetduststeptracker", 2);
		break;
		
		case 2:
		SetParticleSystemActive("PigFeetDustc_*", true);
		SetLocalVarInt("pigfeetduststeptracker", 3);
		break;
		
		case 3:
		SetParticleSystemActive("PigFeetDustd_*", true);
		SetLocalVarInt("pigfeetduststeptracker", 4);
		break;
		
		case 4:
		SetParticleSystemActive("PigFeetDuste_*", true);
		SetLocalVarInt("pigfeetduststeptracker", 5);
		break;
		
		case 5:
		SetParticleSystemActive("PigFeetDustf_*", true);
		SetLocalVarInt("pigfeetduststeptracker", 6);
		break;
		
		case 6:
		SetParticleSystemActive("PigFeetDustg_*", true);
		SetLocalVarInt("pigfeetduststeptracker", 7);
		break;
		
		default:
		AddDebugMessage("Footstep Dust Particles Variable Out of Range!", false);
		break;
	}
}

void KillWalkwayPig (string &in asParent, string &in asChild, int alState)
{
	SetEntityActive("WalkwayPig", false);
	PlaySoundAtEntity("DoorSmashOpen", "afx_church_wretch_door_smash_open.snt", "PigKillTrigger", 0.0f, false);
	PlaySoundAtEntity("WretchMuffled_Part1", "afx_church_wretch_muffled_part1.snt", "PigKillTrigger", 0.0f, false);
	StopSound("PigSweet", 1.0f);
	
	MandusReactionPlayer("Scared", 0.2f);
}
//END WALKWAY PIG EVENT//

//WRETCH FACTORY EVENT PART 2//
void WretchFactoryEventPart2 (string &in asTimer)
{
	PlayMusic("wretch_attack.ogg", true, 1.0f, 1.0f, 4, false);

	PlaySoundAtEntity("DoorSmash3D", "afx_factory_event_wretch_door_smash_3D", "Wretch_Door_Event", 0.0f, false);
	PlaySoundAtEntity("DoorSmash2D", "afx_factory_event_wretch_door_smash_2D", "Wretch_Door_Event", 0.0f, false);
	AddPropForce("Wretch_Door_Event", -10000.0f, 0.0f, 0.0f, "world");
	CreateParticleSystemAtEntity("", "ps_dust_impact_vert.ps", "PigDoorSource", false);

	//LAMP LIGHT TEST- REPLACE WITH FLICKER//
	/*SetLampLit("cellar_gaslamp01_F_long_4", false, false);
	SetLampLit("cellar_gaslamp01_F_long_1", false, false);
	SetLampLit("cellar_gaslamp01_F_long_5", false, false);
	SetLampLit("cellar_gaslamp01_F_long_21", false, false);
	SetLampLit("cellar_gaslamp01_F_long_22", false, false);
	AddTimer("LampLight", 0.15f, "LampLight");*/

	float fHitDoor = RandFloat(1.0f,1.5f);
	AddTimer("WretchFactoryEventPart2_Timer", 1.0f+fHitDoor, "WretchFactoryEventPart2_Timer");
	
	AddEntityCollideCallback("Player", "KillWretchEvent_1", "KillWretchEvent", true, 1);
	AddEntityCollideCallback("Player", "KillWretchEvent_2", "KillWretchEvent", true, 1);
	
	AddTimer("WretchFactoryEventTimeOut", 17.0f, "WretchFactoryEventTimeOut");
}

 void WretchFactoryEventPart2_2 (string &in asTimer)
{
	MandusReactionPlayer("Quick", 0.5f);
}

void WretchFactoryEventPart2_Timer (string &in asTimer)
{
	PlaySoundAtEntity("DoorSmash3D", "afx_factory_event_wretch_door_smash_3D", "Wretch_Door_Event", 0.0f, false);
	PlaySoundAtEntity("DoorSmash2D", "afx_factory_event_wretch_door_smash_2D", "Wretch_Door_Event", 0.0f, false);
	PlaySoundAtEntity("WretchVO", "afx_factory_event_wretch_vocalisations", "Wretch_Door_Event", 0.0f, false);
	AddPropForce("Wretch_Door_Event", -10000.0f, 0.0f, 0.0f, "world");
	CreateParticleSystemAtEntity("", "ps_dust_impact_vert.ps", "PigDoorSource_"+RandInt(1, 4), false);

	//LAMP LIGHT TEST- REPLACE WITH FLICKER//
	/*SetLampFlickerActive("cellar_gaslamp01_F_long_4", true);
	SetLampFlickerActive("cellar_gaslamp01_F_long_1", true);
	SetLampFlickerActive("cellar_gaslamp01_F_long_5", true);
	SetLampFlickerActive("cellar_gaslamp01_F_long_21", true);
	SetLampFlickerActive("cellar_gaslamp01_F_long_22", true);
	AddTimer("LampLight", 0.25f, "LampLight");*/

	float fHitDoor = RandFloat(1.0f,1.5f);
	float fWretchVO = RandFloat(2.0f,3.0f);
	AddTimer("WretchFactoryEventPart2_Timer", 1.0f+fHitDoor, "WretchFactoryEventPart2_Timer");
	AddTimer("WretchFactoryEventPart2_Timer_WretchVO", 0.0f+fWretchVO, "WretchFactoryEventPart2_Timer_WretchVO");
	
	
	
}

void WretchFactoryEventPart2_Timer_WretchVO (string &in asTimer)
{
	PlaySoundAtEntity("WretchVO", "afx_factory_event_wretch_vocalisations", "Wretch_Door_Event", 0.0f, false);
}

void LampLight (string &in asTimer)
{
	//LAMP LIGHT TEST- REPLACE WITH FLICKER//
	SetLampFlickerActive("cellar_gaslamp01_F_long_4", false);
	SetLampFlickerActive("cellar_gaslamp01_F_long_1", false);
	SetLampFlickerActive("cellar_gaslamp01_F_long_5", false);
	SetLampFlickerActive("cellar_gaslamp01_F_long_21", false);
	SetLampFlickerActive("cellar_gaslamp01_F_long_22", false);
}
void WretchFactoryEventTimeOut (string &in asTimer)
{
	RemoveTimer("WretchFactoryEventPart2_Timer");
	RemoveTimer("WretchFactoryEventPart2_Timer_WretchVO");
	
	//PlaySoundAtEntity("Wretch3D", "afx_alley_wretch_door_finishscream_3D", "Wretch_Door_Event", 0.0f, false);
	PlaySoundAtEntity("Wretch2D", "afx_alley_wretch_door_finishscream_2D", "Wretch_Door_Event", 0.0f, false);
	
	RemoveEntityCollideCallback("Player", "KillWretchEvent_1");
	RemoveEntityCollideCallback("Player", "KillWretchEvent_2");	
	
	StopMusic(5.0f, 4);
	
	AddTimer("Alley5", 1.f, "TimerDelayedHint");
}

 

void KillWretchEvent (string &in asParent, string &in asChild, int alState)
{
	if (asChild == "KillWretchEvent_1" || asChild == "KillWretchEvent_2")
	{
		AddDebugMessage("Wretch Event Part 2 Killed", false);
		RemoveEntityCollideCallback("Player", "KillWretchEvent_1");
		RemoveEntityCollideCallback("Player", "KillWretchEvent_2");	
		
		//PlaySoundAtEntity("Wretch3D", "afx_alley_wretch_door_finishscream_3D", "Wretch_Door_Event", 0.0f, false);
		PlaySoundAtEntity("Wretch2D", "afx_alley_wretch_door_finishscream_2D_outside", "Wretch_Door_Event", 0.0f, false);
		AddTimer("Alley5", 3.f, "TimerDelayedHint");
		
		MandusReactionPlayer("Breath", 4.0f);
		
		RemoveTimer("WretchFactoryEventTimeOut");
		RemoveTimer("WretchFactoryEventPart2_Timer");
		RemoveTimer("WretchFactoryEventPart2_Timer_WretchVO");
		
		StopMusic(5.0f, 4);
		MandusReactionPlayer("Breath", 0.0f);
	
	}
}
//END WRETCH FACTORY EVENT PART 2//

//PIG TWITCH//
