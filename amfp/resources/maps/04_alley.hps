			AddEntityCollideCallback("Player", "Alley_Exit_Music_Trigger", "ExitMusicTrigger", true, 1);
			AddEntityCollideCallback("Player", "Child1RunTrigger", "ChildEventHandler", true, 1); 
			AddEntityCollideCallback("Child1", "Child1KillTrigger", "ChildEventHandler", true, 1);
			AddEntityCollideCallback("Player", "Child2RunTrigger", "ChildEventHandler", true, 1); 
			AddEntityCollideCallback("Child2", "Child2KillTrigger", "ChildEventHandler", true, 1);
			AddEntityCollideCallback("Player", "Child3RunTrigger", "ChildEventHandler", true, 1);
			AddEntityCollideCallback("Child3", "Child3KillTrigger", "ChildEventHandler", true, 1);
			AddEntityCollideCallback("Child4", "Child4KillTrigger", "ChildEventHandler", true, 1);
			AddEntityCollideCallback("Player", "Conveyor_Event_Trigger", "Conveyor_Event", false, 0);
			AddEntityCollideCallback("Conveyor_Cage_1", "Conveyor_Cage_1_Kill_Trigger", "Conveyor_Cage_1_Kill", false, 1);
			AddEntityCollideCallback("Conveyor_Cage_1", "Conveyor_Cage_1_Spawn_Trigger", "Conveyor_Cage_1_Spawn2", false, 1);
			AddEntityCollideCallback("Conveyor_Cage_2", "Conveyor_Cage_2_Kill_Trigger", "Conveyor_Cage_2_Kill", false, 1);
			AddEntityCollideCallback("Conveyor_Cage_2", "Conveyor_Cage_2_Spawn_Trigger", "Conveyor_Cage_2_Spawn3", false, 1);
			AddEntityCollideCallback("Conveyor_Cage_3", "Conveyor_Cage_3_Kill_Trigger", "Conveyor_Cage_3_Kill", false, 1);
			AddEntityCollideCallback("Conveyor_Cage_3", "Conveyor_Cage_3_Spawn_Trigger", "Conveyor_Cage_3_Spawn4", false, 1);
			AddEntityCollideCallback("Conveyor_Cage_4", "Conveyor_Cage_4_Kill_Trigger", "Conveyor_Cage_4_Kill", false, 1);
			AddEntityCollideCallback("Conveyor_Cage_4", "Conveyor_Cage_4_Spawn_Trigger", "Conveyor_Cage_4_Spawn5", false, 1);	
			AddEntityCollideCallback("Conveyor_Cage_2", "Conveyor_Cage_2_Lantern_Trigger", "Conveyor_Cage_2_Lantern", false, 0);
			AddEntityCollideCallback("Conveyor_Cage_5", "Conveyor_Cage_5_Kill_Trigger", "Conveyor_Cage_5_Kill", false, 1);
			AddEntityCollideCallback("Conveyor_Cage_5", "Conveyor_Cage_5_Spawn_Trigger", "Conveyor_Cage_5_Spawn6", false, 1);
			AddEntityCollideCallback("Conveyor_Cage_6", "Conveyor_Cage_6_Kill_Trigger", "Conveyor_Cage_6_Kill", false, 1);
