		SetManPigType("Child4", "Freddy");
		SetEnemyMoveType("Child4", "RunBiped");
		SetEnemyDisableTriggers("Child4", true);
	}

	//AUTOSAVE//
	{
		AutoSave();
	}
}

void OnLeave()
{
	SetupLoadScreen("LoadingText", "Church_", 3, "game_loading_church.jpg");
}
										//////////////////////////
										//MAP-SPECIFIC FUNCTIONS//
										//////////////////////////
										
//PHONE TIMER//
void OfficePhoneTimer (string &in asParent, string &in asChild, int alState)
{
	float fPhoneRing = RandFloat(1.0f,2.5f);
	AddTimer("OfficePhone_Timer", 1.0f+fPhoneRing, "OfficePhone_Timer");
	AddDebugMessage("Phone Timer Hit", false);
}

void OfficePhone_Timer (string &in asTimer)
{
	AddDebugMessage("Ring Ring", false);
	StartPhoneRinging("phone_box_1");
	
	SetLampLit("phone_box_light_1", true, true);
	
	SetEntityPlayerInteractCallback("phone_box_1", "InteractPhoneBox", true);
}

void OfficePhoneRingingStop (string &in asParent, string &in asChild, int alState)
{
	AddDebugMessage("Phone Stopped Ringing", false);
	StopPhoneRinging("phone_box_1");
	SetLampLit("phone_box_light_1", false, true);
	SetEntityPlayerInteractCallback("phone_box_1", "", false);
}

void InteractPhoneBox (string &in asEntity)
{
	RemoveTimer("phonetimeout");
	
	AddTimer("PhoneCallTimer", 14.75, "PhoneCallOver");
	StopSound("phone_box_1_AnimEvent", 0.1f);
	
	// Handle spawning of mask 1
	if (GetLocalVarInt("Mask1MaySpawn") == 1)
	{
		SetEntityActive("Mask1", true);
		SetLocalVarInt("Mask1Active", 1);
	}
}

void PhoneCallOver (string &in asTimer)
{
	SetLampLit("phone_box_light_1", false, true);
}
//END PHONE TIMER//

//MASK 1 LOOK TRACKER//
void Mask1LookTracker (string&in asEntity, int alState)
{
	if (alState == 1)
	{
		SetLocalVarInt("Mask1MaySpawn", 1);
		return;
	}
	else if (alState == -1)
	{
		SetLocalVarInt("Mask1MaySpawn", 0);
		return;
	}
}
//END LOOK TRACKER//

//MASK 2A SPAWNER//
void Mask2ASpawner (string &in asParent, string &in asChild, int alState)
{
	SetEntityActive("Mask2A", true);
	SetLocalVarInt("Mask2AActive", 1);
}
//END MASK 2A SPAWNER//

//----------------------
//CONVEYOR BELT//
//----------------------

//-------------------------------------

void Conveyor_Event (string &in asParent, string &in asChild, int alState) //TUrns belt on/off
{
	if (alState == 1)
	{
		AddDebugMessage("COnveyor_EventStart", false);
		
		AddTimer("ConveyorLoop1", 0.01f, "ConveyorLoop1");
		
		SetEntityActive("Conveyor_Cage_4_Lantern_Trigger", true);
		SetLightVisible("PointLight_160", true);
		SetLampLit("cellar_gaslamp01_short_1", true, false);
		SetLampLit("cellar_gaslamp01_F_long_25", true, false);
		SetLampLit("cellar_gaslamp01_F_long_2", true, false);
		SetLampLit("sewer_wall_lamp_2", true, true);
		SetLampLit("sewer_wall_lamp_3", true, true);
		SetLampLit("sewer_wall_lamp_4", true, true);
		SetLampLit("sewer_lights_2", true, true);
		SetLampLit("sewer_lights_4", true, true);
		SetLampLit("sewer_lights_5", true, true);
	}
	else if (alState == -1) 
	{
		AddDebugMessage("End conveyors", false);
		SetEntityActive("Conveyor_Cage_4_Lantern_Trigger", false);
		SetLanternFlickerActive(false);
		
		RemoveTimer("StrobeLightsOn");
		RemoveTimer("StrobeLightsOff");
		RemoveTimer("StrobeHandler");
		
		for(int i=1; i<=6; ++i)
		{
			RemoveTimer("ConveyorLoop"+i);
			SetEntityActive("Conveyor_Cage_"+i, false);
		}
	
		RemoveAttachedPropFromProp("Conveyor_Cage_2", "Conveyor_Wretch");
		SetMoveObjectState("Conveyor_Cage_*", 0);
	}
}

