//AMBIENT SOUNDTRACK PLAYER//
void MapAmbienceAreas (string &in asParent, string &in asChild, int alState)

{		
		if (asChild == "AMBAnnex")
		{
			if (alState == 1)
			{
				PlaySoundAtEntity("annex", "amb_factory_office_tight.snt", "Player", 1.0f, true);
				SetLocalVarString("CurrentAmbientTrack", asChild);
				return;
			}
			else if (alState == -1) 
			{
				StopSound("annex", 1.0f);
				return;
			}
		}
//BREAK//
		if (asChild == "AMBAnnex_1")
		{
			if (alState == 1)
			{
				PlaySoundAtEntity("annex_1", "amb_factory_office_tight.snt", "Player", 1.0f, true);
				SetLocalVarString("CurrentAmbientTrack", asChild);
				return;
			}
			else if (alState == -1) 
			{
				StopSound("annex_1", 1.0f);
				return;
			}
		}
//BREAK//
		if (asChild == "AMBOffices")
		{
			if (alState == 1)
			{
				PlaySoundAtEntity("AMBOffices", "amb_factory_office_tight.snt", "Player", 1.0f, true);
				SetLocalVarString("CurrentAmbientTrack", asChild);
				return;
			}
			else if (alState == -1) 
			{
				StopSound("AMBOffices", 1.0f);
				return;
			}
		}
//BREAK//
		else if (asChild == "AMBAreaAlleyOutside1")
		{
			if (alState == 1)
			{
				PlaySoundAtEntity("alley1", "amb_church_alley_loop.snt", "Player", 1.0f, true);
				SetLocalVarString("CurrentAmbientTrack", asChild);
				return;
			}
			else if (alState == -1) 
			{
				StopSound("alley1", 1.0f);
				return;
			}
		}
//BREAK//
		else if (asChild == "AMBAreaAlleyOutside2")
		{
			if (alState == 1)
			{
				PlaySoundAtEntity("alley2", "amb_church_alley_loop.snt", "Player", 1.0f, true);
				SetLocalVarString("CurrentAmbientTrack", asChild);
				return;
			}
			else if (alState == -1) 
			{
				StopSound("alley2", 1.0f);
				return;
			}
		}
//BREAK//	
		else if (asChild == "AMBAreaAlleyOutside3")
		{
			if (alState == 1)
			{
				PlaySoundAtEntity("alley3", "amb_church_alley_loop.snt", "Player", 1.0f, true);
				SetLocalVarString("CurrentAmbientTrack", asChild);
				return;
