//RANDOM WIND//
void RandomWindSound (string &in asParent, string &in asChild, int alState)
{
	if (asChild == "RandomWindStart_1"|| asChild == "RandomWindStart_2")
	{	
	
	//START WIND
	AddTimer("InitRandomWindSoundCuePlayer", 3.0f, "RandWindSoundCues");
	
	//AREAS
	RemoveEntityCollideCallback("Player", "RandomWindStart_1");
	RemoveEntityCollideCallback("Player", "RandomWindStart_2");
	AddEntityCollideCallback("Player", "RandomWindStop_2", "RandomWindSound", true, 1);
	AddEntityCollideCallback("Player", "RandomWindStop_1", "RandomWindSound", true, 1);
	
	StopSound("CrateEating", 3.0f); //Stop eating sound, as heard through wall.
	
	AddDebugMessage("Wind Sounds START!", true);
	return;
	}
	
	else if (asChild == "RandomWindStop_1"|| asChild == "RandomWindStop_2")
	{
	//REMOVE OUTSIDE SOUND
	RemoveTimer("Player");
	RemoveTimer("RandWindSoundCues");
	AddEntityCollideCallback("Player", "ReturnMusicTrigger", "MusicPlayer", true, 1);
		
	//AREAS
	RemoveEntityCollideCallback("Player", "RandomWindStop_2");
	RemoveEntityCollideCallback("Player", "RandomWindStop_1");
	AddEntityCollideCallback("Player", "RandomWindStart_1", "RandomWindSound", true, 1);
	AddEntityCollideCallback("Player", "RandomWindStart_2", "RandomWindSound", true, 1);
			
	AddDebugMessage("Wind Sounds STOP!", true);
	return;
	}										
}
//END RANDOM WIND//

//RANDOM WAREHOUSE SOUNDS//
void RandomWarehouseSound (string &in asParent, string &in asChild, int alState)
{
	if (asChild == "RandWarehouseSound_Start_1"|| asChild == "RandWarehouseSound_Start_2"|| asChild == "RandWarehouseSound_Start_3")
	{	
	
	//ADD WAREHOUSE TIMER
	AddTimer("InitRandomWarehouseSoundCuePlayer", 3.0f, "RandWarehouseSoundCues");
	AddTimer("InitRandomWarehouseEerieSoundCuePlayer", 6.0f, "RandWarehouseEerieSoundCues");
	
	//AREAS
	RemoveEntityCollideCallback("Player", "RandWarehouseSound_Start_1");
	RemoveEntityCollideCallback("Player", "RandWarehouseSound_Start_2");
	RemoveEntityCollideCallback("Player", "RandWarehouseSound_Start_3");
	AddEntityCollideCallback("Player", "RandWarehouseSound_Stop_3", "RandomWarehouseSound", true, 1);
	AddEntityCollideCallback("Player", "RandWarehouseSound_Stop_2", "RandomWarehouseSound", true, 1);
	AddEntityCollideCallback("Player", "RandWarehouseSound_Stop_1", "RandomWarehouseSound", true, 1);
	
	AddDebugMessage("Warehouse Sounds START!", true);
	return;
	}
	
	else if (asChild == "RandWarehouseSound_Stop_3"|| asChild == "RandWarehouseSound_Stop_2"|| asChild == "RandWarehouseSound_Stop_1")
	{
	//REMOVE WAREHOUSE SOUND
	RemoveTimer("Player");
	RemoveTimer("RandWarehouseSoundCues");
	RemoveTimer("RandWarehouseEerieSoundCues");
		
	//AREAS
	RemoveEntityCollideCallback("Player", "RandWarehouseSound_Stop_3");
	RemoveEntityCollideCallback("Player", "RandWarehouseSound_Stop_2");
	RemoveEntityCollideCallback("Player", "RandWarehouseSound_Stop_1");
	AddEntityCollideCallback("Player", "RandWarehouseSound_Start_1", "RandomWarehouseSound", true, 1);
	AddEntityCollideCallback("Player", "RandWarehouseSound_Start_2", "RandomWarehouseSound", true, 1);
	AddEntityCollideCallback("Player", "RandWarehouseSound_Start_3", "RandomWarehouseSound", true, 1);	
			
	AddDebugMessage("Warehouse Sounds STOP!", true);
	return;
	}										
}
