		SetEntityInteractionDisabled("StoreDoorRight", true);
		SetEntityInteractionDisabled("spectacles_9", true);
		SetEntityInteractionDisabled("false_teeth_9", true);
	}
	
	//DOOR STATES//
	{
		SetSwingDoorClosed("factory_facade_shutters_1", false, false);
		SetSwingDoorDisableAutoClose("factory_facade_shutters_1", true);
		SetSwingDoorClosed("StoreDoorLeft", false, false);
		SetSwingDoorDisableAutoClose("StoreDoorLeft", true);
		SetSwingDoorClosed("StoreDoorRight", false, false);
		SetSwingDoorDisableAutoClose("StoreDoorRight", true);
	}
	
	//LIGHT STATES//
	{
		SetLampLit("TruckBackfireLights", false, false);
	}
	
	//ENEMY SETUP//
	{
		SetManPigType("StoreRoomPig", "Freddy");
		SetEnemyMoveType("StoreRoomPig", "RunBiped");	
		SetManPigType("StorePigAnimation", "Freddy");	
		SetEnemyMoveType("StorePigAnimation", "RunBiped");
		SetEntityActive("StorePigAnimation", true);
	}

	//CHILD SETUP//
	{
		SetManPigType("Child1", "Freddy");
		SetEnemyMoveType("Child1", "RunBiped");
		SetEnemyDisableTriggers("Child1", true);
		SetManPigType("Child2", "Freddy");
		SetEnemyMoveType("Child2", "RunBiped");
		SetEnemyDisableTriggers("Child2", true);
		SetManPigType("Child3", "Freddy");
		SetEnemyMoveType("Child3", "RunBiped");
