			AddEntityCollideCallback("Player", "RandWarehouseSound_Start_2", "RandomWarehouseSound", true, 0);
			AddEntityCollideCallback("Player", "RandWarehouseSound_Start_3", "RandomWarehouseSound", true, 0);
			
			//WIND SOUNDS
			AddEntityCollideCallback("Player", "RandomWindStart_1", "RandomWindSound", true, 1);
			AddEntityCollideCallback("Player", "RandomWindStart_2", "RandomWindSound", true, 1);
			
			//INTERACTION CALLBACKS//
			SetEntityPlayerInteractCallback("CanisterFull_*", "FullCanisterSounds", false);	
			SetEntityPlayerInteractCallback("Level_Transition_Door", "Level_Transition_Music", false);
			SetEntityPlayerInteractCallback("CanisterEmpty_*", "CanisterHint", true);
			
			//STATE CHANGE CALLBACKS//
			SetEntityConnectionStateChangeCallback("TruckBackfireHandleInit", "TruckBackfireEvent");
			
			//PHONE//
			AddEntityCollideCallback("Player", "OfficePhoneTrigger", "OfficePhoneTimer", true, 1);
			AddEntityCollideCallback("Player", "OfficePhoneRingingStop", "OfficePhoneRingingStop", true, 1);
		}
		
	//Setup Initial Object States
		{
			//ATTACHMENTS//
			AddAttachedPropToProp("TruckBackfire", "TruckBackfireLights", "truck_lights_flicker.ent", 0.0f, -1.8f, -5.0f, 0.0f, 0.0f, 0.0f);
			//ANIMATION STATES//
			PlayPropAnimation("fuel_pump_1", "full", 0.0f, true, "");
			PlayPropAnimation("fuel_pump_2", "empty", 0.0f, true, "");
			PlayPropAnimation("clock_grandfather_2", "on", 0.0f, true, "");
			
			//INTERACTION//
			SetEntityInteractionDisabled("cellar_wood01_6", true);
			
			//Conveyor wretch
			AddAttachedPropToProp("Conveyor_Cage_2", "Conveyor_Wretch", "wretch_actor", -0.2, -0.65, -0.35, 0, 0, 0);
		}
		
	//Setup Ambience Callbacks
		{
			AddEntityCollideCallback("Player", "AMBAnnex", "MapAmbienceAreas", false, 0);
			AddEntityCollideCallback("Player", "AMBAnnex_1", "MapAmbienceAreas", false, 0);
			AddEntityCollideCallback("Player", "AMBOffices", "MapAmbienceAreas", false, 0);
			AddEntityCollideCallback("Player", "AMBAreaAlleyOutside1", "MapAmbienceAreas", false, 0);
			AddEntityCollideCallback("Player", "AMBAreaAlleyOutside2", "MapAmbienceAreas", false, 0);
			AddEntityCollideCallback("Player", "AMBAreaAlleyOutside3", "MapAmbienceAreas", false, 0);
			AddEntityCollideCallback("Player", "AMBAreaLoadingAreaSmall", "MapAmbienceAreas", false, 0);
			AddEntityCollideCallback("Player", "AMBAreaFactoryLoading", "MapAmbienceAreas", false, 0);
			AddEntityCollideCallback("Player", "AMBAreaDoorRattle", "MapAmbienceAreas", false, 0);
			AddEntityCollideCallback("Player", "AMBAreaDoorRattle2", "MapAmbienceAreas", false, 0);
			AddEntityCollideCallback("factory_window_1", "WindowCollisionArea", "MapAmbienceAreas", false, 0);
			AddEntityCollideCallback("Player", "AMBAreaLoadingArea_Mach_Pt1", "MapAmbienceAreas", false, 0); 
			AddEntityCollideCallback("Player", "AMBAreaLoadingArea_Mach_Pt1_2", "MapAmbienceAreas", false, 0); 
			AddEntityCollideCallback("Player", "AMBAreaLoadingArea_Mach_Mid", "MapAmbienceAreas", false, 0); 
			AddEntityCollideCallback("Player", "AMBAreaLoadingArea_Mach_Mid_1", "MapAmbienceAreas", false, 0); 
			AddEntityCollideCallback("Player", "AMBAreaLoadingArea_Machine", "MapAmbienceAreas", false, 0);
			SetEntityInteractionDisabled("MusicPhono", true);
			
			//WIND SAMPLES
			AddEntityCollideCallback("OfficeDoor_3", "Sound_WindSpot_1", "Sound_WindSpot_1", false, 0);
			AddEntityCollideCallback("factory_corridor_01_door_2", "Sound_WindSpot_2", "Sound_WindSpot_2", false, 0);
			AddEntityCollideCallback("factory_gate_2", "BigDoorWindTrigger", "Sound_WindSpot_3", false, 0);
			AddEntityCollideCallback("factory_window_1", "WindowCollisionArea", "Sound_WindSpot_4", false, 0);
		}
		
	//Setup Music Callbacks
		{
			AddEntityCollideCallback("OfficeDoor", "OfficeDoorCollider", "MusicPlayer", true, 1);
			AddEntityCollideCallback("Player", "PigsAmbient3MusicTrigger", "MusicPlayer", true, 1);
			AddEntityCollideCallback("CanisterEmpty_1", "CannisterMusicTrigger", "CannisterMusicHandler", true, 0);
		}
		
	//Setup Sound Sting Callbacks
		{
