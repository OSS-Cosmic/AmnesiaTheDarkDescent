				SetLocalVarString("CurrentAmbientTrack", asChild);
				return;
			}
			else if (alState == -1) 
			{
				StopSound("AmbLoadingArea_Mach_Mid_1", 1);
				StopSound("AmbLoadingArea_Mach_Mid_2", 1);
				return;
			}
		}
//BREAK//			
		else if (asChild == "AMBAreaLoadingArea_Mach_Mid_1")
		{
			if (alState == 1)
			{
				PlaySoundAtEntity("AmbLoadingArea_Mach_Mid_3", "amb_loadingarea_macine_mid_loop.snt", "Player", 1.0f, true);
				PlaySoundAtEntity("AmbLoadingArea_Mach_Mid_4", "amb_loadingarea_machine_slice_low.snt", "Player", 1.0f, true);
