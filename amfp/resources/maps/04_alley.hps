	//Setup Initial VO Callbacks
		{
			AddEntityCollideCallback("Player", "vo_alley_child_trigger", "VOPlayer", true, 1);
			AddEntityCollideCallback("Player", "graveyard_flashback_VO", "VOPlayer", true, 1);
		}
		
		AddTimer("", 0, "PushUpDumb");
} 


void PushUpDumb(string &in asTimer)
{
	AddDebugMessage("Pusher!!", false);
	
	AddPropForce("dumb_waiter_lift_door_1", 0, 100, 0, "World");
	
	AddLocalVarInt("PusherUpper", 1);
	
	if(GetLocalVarInt("PusherUpper") < 20) AddTimer("", 0.05, "PushUpDumb");
}


