				return;
			}
			else if (alState == -1) 
			{
				StopSound("AmbLoadingArea_Mach_Pt1", 1);
				return;
			}
		}
//BREAK//		
		else if (asChild == "AMBAreaLoadingArea_Mach_Pt1_2")
