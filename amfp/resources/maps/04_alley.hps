void OnStart()
{
	SetSwingDoorDisableAutoClose("factory_gate_3", true);
	SetSwingDoorClosed("factory_gate_3", false, false);
	SetSwingDoorDisableAutoClose("factory_gate_2", true);
	
	//Map Preamble
	{
		SetMapDisplayNameEntry("Alley");
		//SET CHECKPOINT #1//
		CheckPoint("CP01_Start", "MainStart", "", "", "", false);
		//CLEAR OLD HINTS//
		//RemoveAllHints();
	}
	
	//Debugging
		if(ScriptDebugOn()) 
		{
			GiveItemFromFile("lantern", "lantern.ent");		
			//SetEntityActive("CanisterEmpty_2", true);
		}
		
	// Setup Local Variables
		{
			SetLocalVarInt("Mask1MaySpawn", 0);
			SetLocalVarInt("Mask1Active", 0);
			SetLocalVarInt("Mask2AActive", 0);
			SetLocalVarInt("Mask2BActive", 0);
			SetLocalVarInt("corridorwindareabool", 0);
			SetLocalVarInt("pigfeetduststeptracker", 0);
			SetLocalVarInt("PumpFuelLevel", 8);
			SetLocalVarInt("PumpValveBottomDisabled", 0);
			SetLocalVarInt("PumpValveTopDisabled", 1);
			SetLocalVarInt("FuelFittedToTruck", 0);
		}
	
	//AutoRun Event Timers
		{
			// AddTimer("ConveyorLoop1", 0.01f, "ConveyorLoop1");
		}
		
	//Setup Initial Entity Callbacks
		{
			//COLLISION CALLBACKS//
			AddEntityCollideCallback("Player", "PigSongTrigger", "PigSongTrigger", true, 1);
			AddEntityCollideCallback("spectacles_*", "HitchcockCollisionDetector", "DoHitchcockZoom", true, 1);
			AddEntityCollideCallback("false_teeth_*", "HitchcockCollisionDetector", "DoHitchcockZoom", true, 1);
			AddEntityCollideCallback("Player", "MusicStopTriggerOffices", "MusicStopTriggerOffices", true, 1);
			AddEntityCollideCallback("Player", "OfficeParticleTrigger_1", "OfficeParticleTrigger_1", true, 1);
			AddEntityCollideCallback("Player", "alley_moon_trigger", "AlleyMoonPosition", true, 1);
			AddEntityCollideCallback("Player", "alley_moon_trigger_1", "AlleyMoonPosition", true, 1);
			//Moon light follows the moon billboard swap (ray-traced renderer only)
			SetLightVisible("DirectionalLight_2", false);
			AddEntityCollideCallback("Player", "CrateInteractionOffTrigger", "CrateInteractionUpdater", false, 1);
			AddEntityCollideCallback("Player", "CrateInteractionOnTrigger", "CrateInteractionUpdater", false, 1);
			AddEntityCollideCallback("Player", "AMBAreaWindowWind", "CorridorWindBooleanChecker", false, 0);
			AddEntityCollideCallback("Player", "ChurchStingerTrigger", "ChurchSoundStinger", true, 1);
			AddEntityCollideCallback("Player", "OneShotSFXTrigger1", "OneShotSFXEvents", true, 1);
			AddEntityCollideCallback("Player", "OneShotSFXTrigger2", "OneShotSFXEvents", true, 1);
			AddEntityCollideCallback("Player", "OneShotSFXTrigger3", "OneShotSFXEvents", true, 1);
			AddEntityCollideCallback("WalkwayPig", "PigDustTrigger1", "WalkwayPigDustDrops", true, 1);
			AddEntityCollideCallback("WalkwayPig", "PigDustTrigger2", "WalkwayPigDustDrops", true, 1);
			AddEntityCollideCallback("WalkwayPig", "PigDustTrigger3", "WalkwayPigDustDrops", true, 1);
			AddEntityCollideCallback("WalkwayPig", "PigDustTrigger4", "WalkwayPigDustDrops", true, 1);
			AddEntityCollideCallback("WalkwayPig", "PigDustTrigger5", "WalkwayPigDustDrops", true, 1);
			AddEntityCollideCallback("WalkwayPig", "PigDustTrigger6", "WalkwayPigDustDrops", true, 1);
			AddEntityCollideCallback("WalkwayPig", "PigDustTrigger7", "WalkwayPigDustDrops", true, 1);
			AddEntityCollideCallback("WalkwayPig", "PigKillTrigger", "KillWalkwayPig", true, 1);
			AddEntityCollideCallback("Player", "PigTwitchTrigger", "PigTwitchEvent", true, 1);
			AddEntityCollideCallback("Player", "WretchEventTestTrigger", "WretchFactoryEventPart2", true, 1);
			AddEntityCollideCallback("Player", "StoreLaughTrigger", "StoreLaughEvent", true, 1);
			AddEntityCollideCallback("Player", "StorePigTrigger", "StorePigSequence", true, 1);
			AddEntityCollideCallback("StoreRoomPig", "KillStoreRoomPig", "StorePigSequence", true, 1);
			AddEntityCollideCallback("Player", "Mask2ASpawnTrigger", "Mask2ASpawner", true, 1);
			AddEntityCollideCallback("CanisterEmpty_*", "CanisterMusicTrigger", "CanisterMusic", true, 1);
			AddEntityCollideCallback("CanisterEmpty_*", "PumpCollider", "PumpCanisterHandler", false, 0);
			AddEntityCollideCallback("PumpValve", "PumpValveColliderBottom", "PumpValveHandler", false, 1);
			AddEntityCollideCallback("PumpValve", "PumpValveColliderTop", "PumpValveHandler", false, 1);
