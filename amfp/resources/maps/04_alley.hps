//DRAW MOON IN OPTIMAL POSITION//
void AlleyMoonPosition (string &in asParent, string &in asChild, int alState)
{

	if (asChild == "alley_moon_trigger")
	{
		SetEntityActive("moon_1", false);
		return;
	}
	
	else if (asChild == "alley_moon_trigger_1")
	{
		SetEntityActive("moon_2", false);
		SetLightVisible("DirectionalLight_1", false);
		SetLightVisible("DirectionalLight_2", true);
		return;
	}
}
//END MOON DRAWING//

//SWITCH BOOLEAN VARIABLE FOR CORRIDOR WIND SOUND//
void CorridorWindBooleanChecker (string &in asParent, string &in asChild, int alState)
{
	if (alState == 1)
	{
		SetLocalVarInt("corridorwindareabool", 1);
		return;
	}
	else if (alState == -1)
	{
		SetLocalVarInt("corridorwindareabool", 0);
		return;
	}
}
//END BOOLEAN CHECKER//

