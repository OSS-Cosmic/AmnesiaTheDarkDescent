//TRIGGERED VO PLAYER//
void TimerChurchBellClue(string &in asTimer)
{
	PlaySoundAtEntity("bell", "afx_alley_church_bell.snt", "BellSource", 0.0f, false);
	
}
void VOPlayer (string &in asParent, string &in asChild, int alState)
{
	if (asChild == "vo_alley_child_trigger")
	{
		AddTimer("", 9.321, "TimerChurchBellClue");
		AddEffectVoice("vo_alley_trigger_child_01", "", "Voice", "vo_alley_trigger_child_01", false, "", 0.0f, 0.0f);
		PlaySoundAtEntity("", "afx_gameplay_hightone_10sec.snt", "Player", 1.0f, false);
		PlaySoundAtEntity("", "afx_flashback_whisper.snt", "Player", 1.0f, false);	
		FadeImageTrailTo(2.0f, 2.5f);
		SetPlayerMoveSpeedMul(0.35f);
		SetPlayerLookSpeedMul(0.35f);
		AddTimer("ReturnToNormal", 5.5f, "RestoreToNormal");
		//StartPlayerLookAt("ChurchLookAt", 0.25f, 0.5f, "");
		return;
	}
	else if (asChild == "graveyard_flashback_VO")
	{
		AddEffectVoice("vo_alley_trigger_child_02_flashback.ogg", "", "Voice", "vo_alley_trigger_child_02_flashback", false, "", 0.0f, 0.0f);
		AddTimer("graveyard_flashback_line2", 2.5f, "VOPlayerTimedLines");
		PlaySoundAtEntity("", "afx_gameplay_hightone_10sec.snt", "Player", 1.0f, false);
		PlaySoundAtEntity("", "afx_flashback_whisper.snt", "Player", 1.0f, false);	
		FadeImageTrailTo(2.0f, 2.5f);
		SetPlayerMoveSpeedMul(0.35f);
		SetPlayerLookSpeedMul(0.35f);
		AddTimer("ReturnToNormal", 8.5f, "RestoreToNormal");
		return;
	}
}

void VOPlayerTimedLines (string &in asTimer)
{
	if (asTimer == "graveyard_flashback_line2")
	{
		AddEffectVoice("vo_alley_trigger_mandus_01_flashback.ogg", "", "Voice", "vo_alley_trigger_mandus_01_flashback", false, "", 0.0f, 0.0f);
		AddDebugMessage("Line 2 Triggered!", false);
		return;
	}
}
//END VO PLAYER//

//RANDOMISED SOUND CUE PLAYER//
void RandSoundCues(string &in asTimer)
{
	string[] sCueSources = {"RandSound_1", "RandSound_2", "RandSound_3", "RandSound_4", "RandSound_5", "RandSound_6", };
	asTimer = sCueSources[RandInt (0, 5)];
	PlaySoundAtEntity(asTimer, "afx_spooky_eerie_wind_drone.snt", asTimer, 0, false);
	AddDebugMessage("Random Sound Cue Function Selected EERIE FACTORY Sound Source: "+asTimer, false);
	AddTimer(asTimer, RandFloat(10.0f, 15.0f), "RandSoundCues");
}

void RandWindSoundCues(string &in asTimer)
{
	string[] sCueSources = {"Player"};
	asTimer = sCueSources[0];
	PlaySoundAtEntity(asTimer, "afx_events_mansion_wind.snt", asTimer, 0, false);
	AddDebugMessage("Random Sound Cue Function Selected Wind Sound Source: "+asTimer, false);
	AddTimer(asTimer, RandFloat(10.0f, 15.0f), "RandWindSoundCues");
}

void RandWarehouseSoundCues(string &in asTimer)
{
	string[] sCueSources = {"Player"};
	asTimer = sCueSources[0];
	PlaySoundAtEntity(asTimer, "afx_events_cellar_rand_env.snt", asTimer, 0, false);
	AddDebugMessage("Random Sound Cue Function Selected Environmental Sound Source: "+asTimer, false);
	AddTimer(asTimer, RandFloat(8.0f, 14.0f), "RandWarehouseSoundCues");
}

void RandWarehouseEerieSoundCues(string &in asTimer)
{	
	string[] sCueSources = {"Player"};
	asTimer = sCueSources[0];
	PlaySoundAtEntity(asTimer, "afx_spooky_stereo_whisper.snt", asTimer, 0, false);
	AddDebugMessage("Random Sound Cue Function Selected Eerie Sound Source: "+asTimer, false);
	AddTimer(asTimer, RandFloat(20.0f, 30.0f), "RandWarehouseEerieSoundCues");
}

void RandChildCryCues(string &in asTimer)
{
	PlaySoundAtEntity("Crying", "spooky_childcry_small_area.snt", "ChildCrySource", 0, false);
	AddTimer(asTimer, RandFloat(10.0f, 15.0f), "RandChildCryCues");
	AddDebugMessage("ChildCryPlaying", false);
}

void RandOfficeSoundCues(string &in asTimer)
{
	string[] sCueSources = {"RandOfficeSoundArea_1", "RandOfficeSoundArea_2", "RandOfficeSoundArea_3", "RandOfficeSoundArea_4", "RandOfficeSoundArea_5", "RandOfficeSoundArea_6", "RandOfficeSoundArea_7", "RandOfficeSoundArea_8"};
	asTimer = sCueSources[RandInt (0, 7)];
	PlaySoundAtEntity(asTimer, "afx_spooky_mansion_backarea_abstract.snt", asTimer, 0, false);
	AddDebugMessage("Random Sound Cue Function Selected EERIE OFFICE Sound Source: "+asTimer, false);
	AddTimer(asTimer, RandFloat(8.0f, 13.0f), "RandOfficeSoundCues");
}
//END RANDOMISED SOUND CUE PLAYER//	

//MANDUS REACTION SOUND PLAYER//
void MandusReactionPlayer (string asReactType, float afWaitTime)
{
	SetLocalVarString("CurrentReactType", asReactType);
	AddTimer("MandusReactionInternalTimer", afWaitTime, "MandusReactionPlayerTimerEnd");
}

void MandusReactionPlayerTimerEnd (string &in asTimer)
{
	if (GetLocalVarString("CurrentReactType") == "Scared")
	{
		AddDebugMessage("SCARED REACTION", false);
		PlaySoundAtEntity("", "react_scare.snt", "Player", 0.0f, false);
		return;
	}
	else if (GetLocalVarString("CurrentReactType") == "Breath")
	{
		AddDebugMessage("BREATH REACTION", false);
		PlaySoundAtEntity("", "react_breath.snt", "Player", 0.0f, false);
		return;
	}
	else if (GetLocalVarString("CurrentReactType") == "Quick")
	{
		AddDebugMessage("QUICK SCARE REACTION", false);
		PlaySoundAtEntity("", "react_quickscare.snt", "Player", 0.0f, false);
		return;
	}
	else if (GetLocalVarString("CurrentReactType") == "Cough")
	{
		AddDebugMessage("COUGH REACTION", false);
		PlaySoundAtEntity("", "react_cough.snt", "Player", 0.0f, false);
		return;
	}
}
//END MANDUS REACTION SOUND PLAYER//

//MUSIC PLAYER//
void MusicPlayer (string &in asParent, string &in asChild, int alState)
{
	if (asChild == "OfficeDoorCollider")
	{
		PlayMusic("music_church_going_outside.ogg", false, 1.0f, 0.0f, 2, false);
		return;
	}
	else if (asChild == "PigsAmbient3MusicTrigger")
	{
		PlayMusic("music_church_pig_ambient_3.ogg", false, 1.0f, 0.0f, 0, false);
		return;
	}
	else if (asChild == "ReturnMusicTrigger")
	{
		AddDebugMessage("Music alley walking back Triggered", false);
		PlayMusic("music_alley_walkingback.ogg", false, 1.0f, 0.0f, 0, false);
		return;
	}
	
}
//END MUSIC PLAYER//

//MAP CHILD EVENT HANDLER//
void ChildEventHandler (string &in asParent, string &in asChild, int alState)
{
	if (asChild == "Child1RunTrigger")
	{
		SetEntityActive("Child1", true);
		AddEnemyPatrolNode("Child1", "PathNodeArea_11", 0.0f, "", false);
		AddEnemyPatrolNode("Child1", "PathNodeArea_12", 0.0f, "", false);
		AddEnemyPatrolNode("Child1", "PathNodeArea_13", 0.0f, "", false);
		AddEnemyPatrolNode("Child1", "PathNodeArea_21", 0.0f, "", false);
		return;
	}
	
	else if (asChild == "Child1KillTrigger")
	{
		ClearEnemyPatrolNodes("Child1");
		SetEntityActive("Child1", false);
		return;
	}	
	else if (asChild == "Child2RunTrigger")
	{
		SetEntityActive("Child2", true);
		AddEnemyPatrolNode("Child2", "PathNodeArea_22", 0.0f, "", false);
		AddEnemyPatrolNode("Child2", "PathNodeArea_23", 0.0f, "", false);
		return;
	}
	else if (asChild == "Child2KillTrigger")
	{
		ClearEnemyPatrolNodes("Child2");
		SetEntityActive("Child2", false);
		return;
	}	
	else if (asChild == "Child3RunTrigger")
	{
		SetEntityActive("Child3", true);
		SetEntityActive("Child4", true);
		PlaySoundAtEntity("laugh", "afx_spooky_child_laugh_alley.snt", "Child3", 0, false);
		AddTimer("", 6, "TimerSecondLaugh");
		AddEnemyPatrolNode("Child3", "PathNodeArea_50", 0.0f, "", false);
		AddEnemyPatrolNode("Child4", "PathNodeArea_50", 0.0f, "", false);
		AddEnemyPatrolNode("Child3", "PathNodeArea_53", 0.0f, "", false);
		AddEnemyPatrolNode("Child4", "PathNodeArea_53", 0.0f, "", false);
		AddEnemyPatrolNode("Child3", "PathNodeArea_42", 0.0f, "", false);
		AddEnemyPatrolNode("Child4", "PathNodeArea_42", 0.0f, "", false);
		AddEnemyPatrolNode("Child3", "PathNodeArea_39", 0.0f, "", false);
		AddEnemyPatrolNode("Child4", "PathNodeArea_39", 0.0f, "", false);
		AddEnemyPatrolNode("Child3", "PathNodeArea_36", 0.0f, "", false);
		AddEnemyPatrolNode("Child4", "PathNodeArea_36", 0.0f, "", false);
		AddEnemyPatrolNode("Child3", "PathNodeArea_34", 0.0f, "", false);
		AddEnemyPatrolNode("Child4", "PathNodeArea_34", 0.0f, "", false);
		AddEnemyPatrolNode("Child3", "PathNodeArea_48", 0.0f, "", false);
		AddEnemyPatrolNode("Child4", "PathNodeArea_48", 0.0f, "", false);
		AddEnemyPatrolNode("Child3", "PathNodeArea_46", 0.0f, "", false);
		AddEnemyPatrolNode("Child4", "PathNodeArea_46", 0.0f, "", false);
		AddEnemyPatrolNode("Child3", "PathNodeArea_18", 0.0f, "", false);
		AddEnemyPatrolNode("Child4", "PathNodeArea_18", 0.0f, "", false);
		
		return;
	}
	
	else if (asChild == "Child3KillTrigger")
	{
		ClearEnemyPatrolNodes("Child3");
		SetEntityActive("Child3", false);
		return;
	}	
	
	else if (asChild == "Child4KillTrigger")
	{
		ClearEnemyPatrolNodes("Child4");
		SetEntityActive("Child4", false);
		return;
	}	
	
}	

void TimerSecondLaugh(string &in asTimer)
{
	PlaySoundAtEntity("laugh2", "afx_spooky_child_laugh_alley.snt", "Child3", 1, false);
}
//END MAP CHILD EVENT HANDLER//


