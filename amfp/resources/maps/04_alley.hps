			}
		}
//BREAK//	
		else if (asChild == "AMBAreaLoadingAreaSmall")
		{
			if (alState == 1)
			{
				PlaySoundAtEntity("alleyloading", "amb_factory_office_tight.snt", "Player", 1.0f, true);
				SetLocalVarString("CurrentAmbientTrack", asChild);
				return;
			}
			else if (alState == -1) 
			{
				StopSound("alleyloading", 1.0f);
				return;
			}
		}
//BREAK//
		else if (asChild == "AMBAreaFactoryLoading")
		{
			if (alState == 1)
			{
				PlaySoundAtEntity("loadingarea", "amb_church_alley_loadingarea.snt", "Player", 1.0f, true);
				SetLocalVarString("CurrentAmbientTrack", asChild);
				return;
			}
			else if (alState == -1) 
			{
				StopSound("loadingarea", 1.0f);
				return;
			}
		}
//BREAK//		
		else if (asChild == "AMBAreaDoorRattle")
		{
			if (alState == 1)
			{
				PlaySoundAtEntity("doorrattle", "amb_church_loadingarea_door_rattle.snt", "AMBDoorRattle_Source", 1.0f, true);
				SetLocalVarString("CurrentAmbientTrack", asChild);
				return;
			}
			else if (alState == -1) 
			{
				StopSound("doorrattle", 1.0f);
				return;
			}
		}
//BREAK//
		else if (asChild == "AMBAreaDoorRattle2")
		{
			if (alState == 1)
			{
				PlaySoundAtEntity("doorrattle2", "amb_church_loadingarea_door_rattle.snt", "AMBDoorRattle_Source", 1.0f, true);
				SetLocalVarString("CurrentAmbientTrack", asChild);
				return;
			}
			else if (alState == -1) 
			{
				StopSound("doorrattle2", 1.0f);
				return;
			}
		}

	
		
//SEPARATE BLOCK FOR LOADING AREA MACHINE AMBIENCE//
			
		else if (asChild == "AMBAreaLoadingArea_Mach_Pt1")
