			//Make all furnances turned on.
			//SetLocalVarInt("FurnaceLitTotal", 3);
			//FurnaceSwitchTimedEvents("");
			
			//Make the map dark and turn on pistons
			//SetLocalVarInt("PistonsOn",3);
			//PistonLeverHandler("",1);
			
			SetMoveObjectState("Gate3", 0.75f);
		}
}	

