			AddEntityCollideCallback("Player", "AMBPistonRoom", "MapAmbienceAreas", false, 0);	//Piston Room
			AddEntityCollideCallback("Player", "AMBPistonUnder", "MapAmbienceAreas", false, 0);	//Piston Room
