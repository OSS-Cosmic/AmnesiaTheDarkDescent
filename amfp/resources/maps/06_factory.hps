	AddEntityCollideCallback("Player", "AreaFakeEnc3", "EnterFakeEnc3", true, 1);
	
	AddEntityCollideCallback("Player", "AreaAwayFromPigs", "AwayFromPigs", true, 1);

SetEntityActive("tube_lamp_factory_railing_47", false); SetEntityActive("tube_lamp_factory_railing_48", false); SetEntityActive("tube_lamp_factory_railing_16", false);
SetEntityActive("tube_lamp_factory_railing_49", false); SetEntityActive("tube_lamp_factory_railing_9", false); SetEntityActive("cellar_gaslamp01_F_short_8", false);
SetEntityActive("cellar_gaslamp01_F_short_5", false); SetEntityActive("cellar_gaslamp01_F_short_6", false); SetEntityActive("fan_ceiling_short_2", false);
SetEntityActive("fan_ceiling_short_1", false); SetEntityActive("cellar_gaslamp01_F_short_2", false); SetEntityActive("cellar_gaslamp01_F_short_1", false);
SetEntityActive("cellar_gaslamp01_F_short_3", false); SetEntityActive("tube_lamp_factory_railing_12", false); SetEntityActive("tube_lamp_factory_railing_15", false);
SetEntityActive("Lever3", false); SetEntityActive("Lever2", false); SetEntityActive("Lever1", false);
SetEntityActive("cellar_gaslamp01_F_short_4", false); SetEntityActive("tube_lamp_factory_railing_10", false); SetEntityActive("tube_lamp_factory_railing_51", false);
SetEntityActive("tube_lamp_factory_railing_52", false); SetEntityActive("tube_lamp_factory_railing_11", false); SetEntityActive("tube_lamp_factory_railing_50", false);
SetEntityActive("tube_lamp_factory_railing_13", false); SetEntityActive("CoalPiece_*", false); SetEntityActive("engineroom_office_door_1", false);
SetEntityActive("engineroom_office_door_2", false); SetEntityActive("engineroom_balcony_office_window_*", false);

	CheckPoint("BottomCheckPoint", "CheckpointBottom", "CheckpointBottom", "", "", false);
}

