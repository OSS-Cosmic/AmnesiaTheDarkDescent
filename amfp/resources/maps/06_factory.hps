			AddEntityCollideCallback("Player", "AreaCollideOcclusion_4", "CollideSwitchOccluder", false, 0);
			AddEntityCollideCallback("Player", "AreaCollideOcclusion_5", "CollideSwitchOccluder", false, 0);


			//COLLISION CALLBACKS//
