//DOOR SCRATCH EVENT//
void DoorScratchEvent (string &in asEntity)
{
	AddDebugMessage("Scratch Timer Started", false);
	float fScratch = RandFloat(1.0f,2.5f);
	AddTimer("ScratchDoorTimer", 0.5f+fScratch, "ScratchDoorTimer");
}

void ScratchDoorTimer (string &in asTimer)
{
	AddDebugMessage("Scratch Started and Crying Timer Begin", false);
	float fScratch = RandFloat(1.0f,2.5f);
	PlaySoundAtEntity("Scratch", "afx_spooky_mansion_backarea_abstract_04", "tunnels_door_5", 0.0f, false);
	AddTimer("CryingDoorTimer", 0.5f+fScratch, "CryingDoorTimer");
}

void CryingDoorTimer (string &in asTimer)
{
	AddDebugMessage("Crying Started", false);
	PlaySoundAtEntity("Scratch", "spooky_childcry_quiet", "tunnels_door_4", 0.0f, false);
}

//RESTORE TO NORMAL//
void RestoreToNormal (string &in asTimer)
{
//RETURN TO NORMAL VISION
	if (asTimer == "ReturnToNormalVision")
	{
		FadeRadialBlurTo(0.0f, 4.0f);
		FadeImageTrailTo(0.0f, 4.0f);
		return;
	}

//RETURN TO NORMAL ALL//
	else if (asTimer == "ReturnToNormal")
	{
		FadeImageTrailTo(0.0f, 3.0f);
		SetPlayerLookSpeedMul(1.0f);
		SetPlayerMoveSpeedMul(1.0f);
		StopPlayerLookAt();
		return;
	}
	
//END VISUAL EFFECT FOR SCREAM//
	else if (asTimer == "EndVisEffect")
	{
		FadeImageTrailTo(0.0f, 0.5f);
		FadeSepiaColorTo(0.0f, 0.5f);
		return;
	}
}
//END RESTORE TO NORMAL//

//BARREL ROLL HANDLER//
void BarrelHandler (string &in asParent, string &in asChild, int alState)
{
	if (asChild == "barrel_roll_trigger")
	{
		SetEntityActive("barrel_blocker", false);
		SetEntityActive("barrel_blocker_1", false);
		AddPropForce("barrel_roll_2", 8500.0f, 0.0f, 0.0f, "world");
		AddPropForce("barrel_roll_1", 9500.0f, 0.0f, 0.0f, "world");
		AddPropForce("barrel_roll_3", -8500.0f, 0.0f, 0.0f, "world");
		AddPropForce("barrel_roll_4", -9500.0f, 0.0f, 0.0f, "world");
		PlaySoundAtEntity("barrel_sound_source", "", "Player", 1.0f, false);
		AddTimer("BarrelCrowTimer", 0.5f, "BarrelCrows");
		return;
	}
}

void BarrelCrows (string &in asTimer)
{
	PlaySoundAtEntity("", "event_factory_crows.snt", "CrowSource", 0.0f, false);
}

//END BARREL ROLL HANDLER

//YARD WIND EVENT//
void YardWindEvent (string &in asParent, string &in asChild, int alState)
{
	SetParticleSystemActive("YardWindParticles", true);
	PlaySoundAtEntity("", "spooky_wind_whirl.snt", "Player", 0.0f, false);
}
//END YARD WIND EVENT//

//RANDOM WIND//
void RandomWindSound (string &in asParent, string &in asChild, int alState)
{
	if (asChild == "StartWindDynamic_1"|| asChild == "StartWindDynamic_2")
	{	
		//START WIND
		AddTimer("InitRandomWindSoundCuePlayer", 3.0f, "RandWindSoundCues");
		
		//AREAS
		RemoveEntityCollideCallback("Player", "StartWindDynamic_1");
		RemoveEntityCollideCallback("Player", "StartWindDynamic_2");
		AddEntityCollideCallback("Player", "StopWindDynamic_2", "RandomWindSound", true, 1);
		AddEntityCollideCallback("Player", "StopWindDynamic_1", "RandomWindSound", true, 1);
		
		AddDebugMessage("Wind Sounds START!", true);
		return;
	}
	
	else if (asChild == "StopWindDynamic_1"|| asChild == "StopWindDynamic_2")
	{
		//REMOVE OUTSIDE SOUND
		RemoveTimer("Player");
		RemoveTimer("RandWindSoundCues");
			
		//AREAS
		RemoveEntityCollideCallback("Player", "StopWindDynamic_2");
		RemoveEntityCollideCallback("Player", "StopWindDynamic_1");
		AddEntityCollideCallback("Player", "StartWindDynamic_1", "RandomWindSound", true, 1);
		AddEntityCollideCallback("Player", "StartWindDynamic_2", "RandomWindSound", true, 1);
				
		AddDebugMessage("Wind Sounds STOP!", true);
		return;
	}										
}
//END RANDOM WIND//

//MAP CHILD EVENT HANDLER//
void ChildEventHandler (string &in asParent, string &in asChild, int alState)
{
	if (asChild == "ChildSpawnTrigger")
	{
		AddDebugMessage("Child Spawn", false);
		SetEntityActive("child_1", true);
		SetEntityActive("child_2", true);
		SetEnemyMoveType("child_1", "Idle");
		SetEnemyMoveType("child_2", "Idle");
		return;
	}
	
	else if (asChild == "ChildRunTrigger")
	{
		AddDebugMessage("Run Forrest Run", false);
		SetEnemyMoveType("child_1", "RunBiped");
		SetEnemyMoveType("child_2", "RunBiped");
		AddEnemyPatrolNode("child_1", "ChildBottomAreaNode_1", 0.0f, "", false);
		AddEnemyPatrolNode("child_1", "ChildBottomAreaNode_2", 0.0f, "", false);
		AddEnemyPatrolNode("child_1", "ChildBottomAreaNode_3", 0.0f, "", false);
		AddEnemyPatrolNode("child_1", "ChildBottomAreaNode_4", 0.0f, "", false);
		AddEnemyPatrolNode("child_1", "ChildBottomAreaNode_5", 0.0f, "", false);
		AddTimer("ChildKillSound", 4.0f, "ChildKillSound");
		AddTimer("LazyBonesSound", 35.0f, "LazyBonesSound");
	}
	

	else if (asChild == "ChildBottomAreaKillTrigger")
	{
		AddDebugMessage("Child Killed", false);
		ClearEnemyPatrolNodes("child_1");
		ClearEnemyPatrolNodes("child_2");
		SetEntityActive("child_1", false);
		SetEntityActive("child_2", false);
		return;
	}	
}
	void ChildKillSound (string &in asTimer)
	{
		AddDebugMessage("ChildKillSound", false);
		PlaySoundAtEntity("ChildKillSound", "afx_spooky_pig_scream_01.snt", "ChildKillSound", 0.0f, false);
		MandusReactionPlayer("Breath", 1.0f);
		MandusReactionPlayer("Breath", 7.0f);
	}
	
	void LazyBonesSound (string &in asTimer)
	{
		AddDebugMessage("Come On Slowcoach", false);
		PlaySoundAtEntity("ChildKillSound", "afx_spooky_eerie_monster.snt", "ChildLaughSound", 0.0f, false);
		AddTimer("LazyBonesSound", 85.0f, "LazyBonesSound");
	}
	
	void ChildSoundTunnelsDoor (string &in asEntity)
	{
		SetEntityPlayerInteractCallback("tunnels_door_1", "ChildSoundTunnelsDoor", false);
		AddDebugMessage("Child Laugh Door Timer Active", false);
		AddTimer("ChildLaughDoorSound", 1.0f, "ChildLaughDoorSound");
	}
	
	void ChildLaughDoorSound (string &in asTimer)
	{
		AddDebugMessage("HaHa", false);
		PlaySoundAtEntity("ChildLaughSound", "afx_spooky_child_laugh_semi_distant.snt", "ChildLaughSound", 0.0f, false);
	}
//END MAP CHILD EVENT HANDLER//

//DEATH HANDLER//
void DeathHandler (string &in asName, int alCount)
{
	if (alCount == 0)
	{
		AddDebugMessage("Player Has Died. Death Count is "+alCount+".", false);
		SetPlayerCrouching(true);
		SetPlayerActive(false);
		AddTimer("Death1Timer1", 2.0f, "DeathTimer1Sequence");
		AddTimer("Death1Timer2", 5.0f, "DeathTimer1Sequence");
		AddTimer("Death1Timer3", 6.0f, "DeathTimer1Sequence");
		AddTimer("Death1Timer4", 8.0f, "DeathTimer1Sequence");
		AddTimer("Death1Timer5", 9.0f, "DeathTimer1Sequence");
		AddTimer("Death1Timer6", 13.5f, "DeathTimer1Sequence");
		return;
	}
	else if (alCount >= 1)
	{
		AddDebugMessage("Player Has Died. Death Count is "+alCount+".", false);
		AddTimer("Death2Timer1", 2.0f, "DeathTimer2Sequence");
		AddTimer("Death2Timer2", 5.0f, "DeathTimer2Sequence");
		AddTimer("Death2Timer3", 6.0f, "DeathTimer2Sequence");
		AddTimer("Death2Timer4", 8.0f, "DeathTimer2Sequence");
		AddTimer("Death2Timer5", 9.0f, "DeathTimer2Sequence");
		AddTimer("Death2Timer6", 13.5f, "DeathTimer2Sequence");
		return;
	}
	else
	{
		ReleasePlayerFromLimbo();
		return;
	}
}

void DeathTimer1Sequence (string &in asTimer)
{
	if (asTimer == "Death1Timer1")
	{
		PlaySoundAtEntity("", "afx_spooky_hifrequencymoan_2D.snt", "Player", 0.0f, false);
		return;
	}
	else if (asTimer == "Death1Timer2" || asTimer == "Death1Timer3" || asTimer == "Death1Timer4")
	{
		PlaySoundAtEntity("", "afx_spooky_monster_noises_tight_2D.snt", "Player", 0.0f, false);
	}
	else if (asTimer == "Death1Timer5")
	{
		PlaySoundAtEntity("", "00_intro_falling.snt", "Player", 0.0f, false);
		return;
	}
	else if (asTimer == "Death1Timer6")
	{
		ReleasePlayerFromLimbo();
		SetPlayerActive(true);
		CheckPoint("CP04_UnderPiston", "CheckpointStart_3", "DeathHandler", "", "", true);
		return;
	}
}

void DeathTimer2Sequence (string &in asTimer)
{
	if (asTimer == "Death12Timer1")
	{
		PlaySoundAtEntity("", "afx_spooky_hifrequencymoan_2D.snt", "Player", 0.0f, false);
		return;
	}
	else if (asTimer == "Death2Timer2" || asTimer == "Death2Timer3" || asTimer == "Death2Timer4")
	{
		PlaySoundAtEntity("", "afx_spooky_monster_noises_tight_2D.snt", "Player", 0.0f, false);
	}
	else if (asTimer == "Death2Timer5")
	{
		PlaySoundAtEntity("", "00_intro_falling.snt", "Player", 0.0f, false);
		return;
	}
	else if (asTimer == "Death2Timer6")
	{
		ReleasePlayerFromLimbo();
		SetPlayerActive(true);
		return;
	}
}

//LEVEL TRANSITION HANDLER//
void LevelTransitionHandler (string &in asParent, string &in asChild, int alState)
{
	StopSound("Piston1Wheel2", 3); StopSound("Piston2Wheel2", 3); StopSound("Piston2Wheel2", 3);
	StopSound("AMBPistonUnder", 3); StopSound("Piston2DQuieter", 3); StopSound("Piston2D", 3);
	     
	FadeOut(0.8);
	
	SetPlayerMoveSpeedMul(0.8);
	SetPlayerLookSpeedMul(0.8);
	
	PlayGuiSound("player_crouch1.ogg", 1);
	AddTimer("end_1", 0.2, "TimerEndSeq");
	AddTimer("end_2", 0.7, "TimerEndSeq");
	AddTimer("end_3", 0.8, "TimerEndSeq");
	AddTimer("end_4", 1.6, "TimerEndSeq");
	
	AddTimer("LevelTransitionBuffer", 3.0f, "LevelLoader");
	
	PlayMusic("music_factory_leveltransition.ogg", true, 1.0f, 1.0f, 8, true);
}

void TimerEndSeq(string &in asTimer)
{
	if(asTimer == "end_1")
	{
		PlayGuiSound("metal_engroom_sneak_4.ogg", 0.9f);
		SetPlayerMoveSpeedMul(0.6);
		SetPlayerLookSpeedMul(0.6);
	}
	if(asTimer == "end_2")
	{
		PlayGuiSound("player_crouch3", 0.8f);
		SetPlayerMoveSpeedMul(0.4);
		SetPlayerLookSpeedMul(0.4);
	}
	if(asTimer == "end_3")
	{
		PlayGuiSound("metal_engroom_sneak_2.ogg", 0.7f);
		SetPlayerActive(false);
		PlaySoundAtEntity("move_sound", "joint_dumb_waiter_door_move_endoflevel.snt", "dumb_waiter_lift_door_1", 0.5, false);
	}
	if(asTimer == "end_4")
	{
		StopSound("move_sound", 0.2);
		PlaySoundAtEntity("", "joint_dumb_waiter_door_close.snt", "dumb_waiter_lift_door_1", 0.4, false);
	}
}
void LevelLoader (string &in asTimer)
{
	ChangeMap("07_tunnels.map", "InitStart", "", "");
}
//END LEVEL TRANSITION HANDLER//

