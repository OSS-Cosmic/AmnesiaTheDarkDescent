//SOUND OPTIMISATIONS//
void soundopt (string &in asParent, string &in asChild, int alState)
{
//COURTYARD OPTIMSATION
	if (asChild == "soundopt_courtyard_start_2"|| asChild == "soundopt_courtyard_start_1")
	{
	//REMOVE START TRIGGERS
	RemoveEntityCollideCallback("Player", "soundopt_courtyard_start_2");
	RemoveEntityCollideCallback("Player", "soundopt_courtyard_start_1");
	
	//ADD STOP TRIGGERS
	AddEntityCollideCallback("Player", "soundopt_courtyard_stop_1", "soundopt", true, 1);
	AddEntityCollideCallback("Player", "soundopt_courtyard_stop_2", "soundopt", true, 1);
	
	//START SOUND TIMER
	AddTimer("InitRandomCourtyardSoundCuePlayer", 5.0f, "RandCourtyardSoundCues");
	
	//DEBUG MESSAGE
	AddDebugMessage("Start Courtyard Sounds", true);
	}
//BREAK
	if (asChild == "soundopt_courtyard_stop_1"|| asChild == "soundopt_courtyard_stop_2")
	{
	//REMOVE STOP TRIGGERS
	RemoveEntityCollideCallback("Player", "soundopt_courtyard_stop_1");
	RemoveEntityCollideCallback("Player", "soundopt_courtyard_stop_2");
	
	//ADD START TRIGGERS
	AddEntityCollideCallback("Player", "soundopt_courtyard_start_1", "soundopt", true, 1);
	AddEntityCollideCallback("Player", "soundopt_courtyard_start_2", "soundopt", true, 1);
	
	//REMOVE SOUNDS
	RemoveTimer("CourtyardSource_1");
	RemoveTimer("CourtyardSource_2");
	RemoveTimer("CourtyardSource_3");
	RemoveTimer("CourtyardSource_4");
	RemoveTimer("CourtyardSource_5");
	RemoveTimer("InitRandomCourtyardSoundCuePlayer");
	RemoveTimer("RandCourtyardSoundCues");
	
	//DEBUG MESSAGE
	AddDebugMessage("Stop Courtyard Sounds", true);
	}
//BREAK
//PISTON ROOM
	if (asChild == "soundopt_pistonenv_start_1"|| asChild == "soundopt_pistonenv_start_2"|| asChild == "soundopt_pistonenv_start_3")
	{
	//REMOVE START TRIGGERS
	RemoveEntityCollideCallback("Player", "soundopt_pistonenv_start_1");
	RemoveEntityCollideCallback("Player", "soundopt_pistonenv_start_2");
	RemoveEntityCollideCallback("Player", "soundopt_pistonenv_start_3");
	
	//ADD STOP TRIGGERS
	AddEntityCollideCallback("Player", "soundopt_pistonenv_stop_1", "soundopt", true, 1);
	AddEntityCollideCallback("Player", "soundopt_pistonenv_stop_2", "soundopt", true, 1);
	AddEntityCollideCallback("Player", "soundopt_pistonenv_stop_3", "soundopt", true, 1);
	
	//START SOUND TIMER
	AddTimer("InitRandomPistonSoundCuePlayer", 4.0f, "RandPistonSoundCues");
	
	//DEBUG MESSAGE
	AddDebugMessage("Start Piston Room Env Sounds", true);
	}
//BREAK
	if (asChild == "soundopt_pistonenv_stop_1"|| asChild == "soundopt_pistonenv_stop_2"|| asChild == "soundopt_pistonenv_stop_3")
	{
	//REMOVE STOP TRIGGERS
	RemoveEntityCollideCallback("Player", "soundopt_pistonenv_stop_1");
	RemoveEntityCollideCallback("Player", "soundopt_pistonenv_stop_2");
	RemoveEntityCollideCallback("Player", "soundopt_pistonenv_stop_3");
	
	//ADD START TRIGGERS
	AddEntityCollideCallback("Player", "soundopt_pistonenv_start_1", "soundopt", true, 1);
	AddEntityCollideCallback("Player", "soundopt_pistonenv_start_2", "soundopt", true, 1);
	AddEntityCollideCallback("Player", "soundopt_pistonenv_start_3", "soundopt", true, 1);
	
	//REMOVE SOUNDS
	RemoveTimer("Player");
	RemoveTimer("InitRandomPistonSoundCuePlayer");
	RemoveTimer("RandPistonSoundCues");
	
	//DEBUG MESSAGE
	AddDebugMessage("Stop Piston Room Env Sounds", true);
	}
//BREAK
//PISTON BOTTOM WHEELS
	if (asChild == "soundopt_pistonwheel_start")
	{
	//REMOVE START TRIGGERS
	RemoveEntityCollideCallback("Player", "soundopt_pistonwheel_start");
	
	//ADD STOP TRIGGERS
	AddEntityCollideCallback("Player", "soundopt_pistonwheel_stop", "soundopt", true, 1);
	
	//START PISTON WHEEL SOUNDS
	PlaySoundAtEntity("Piston1Wheel2", "factory_piston_wheel2_pers_3D.snt", "factory_pistons_1_wheel2_source", 0.0f, true);
	PlaySoundAtEntity("Piston2Wheel2", "factory_piston_wheel2_pers_3D_2.snt", "factory_pistons_2_wheel2_source", 0.0f, true);
	PlaySoundAtEntity("Piston3Wheel2", "factory_piston_wheel2_pers_3D_3.snt", "factory_pistons_3_wheel2_source", 0.0f, true);
	
	//DEBUG MESSAGE
	AddDebugMessage("Start Piston Room Wheel Sounds", true);
	}
//BREAK
	if (asChild == "soundopt_pistonwheel_stop")
	{
	//REMOVE STOP TRIGGERS
	RemoveEntityCollideCallback("Player", "soundopt_pistonwheel_stop");
	
	//ADD START TRIGGERS
	AddEntityCollideCallback("Player", "soundopt_pistonwheel_start", "soundopt", true, 1);
	
	//REMOVE SOUNDS
	StopSound("Piston1Wheel2", 1.0f);
	StopSound("Piston2Wheel2", 1.0f);
	StopSound("Piston3Wheel2", 1.0f);
	
	//DEBUG MESSAGE
	AddDebugMessage("Stop Piston Room Wheel Sounds", true);
	}
//BREAK
//PISTON SOFTER SOUND
	if (asChild == "soundopt_pistonquieter_start")
	{
	//REMOVE START TRIGGERS
	RemoveEntityCollideCallback("Player", "soundopt_pistonquieter_start");
	
	//ADD STOP TRIGGERS
	AddEntityCollideCallback("Player", "soundopt_pistonquieter_stop", "soundopt", true, 1);
	
	//STOP PISTON LOUD SOUND
	StopSound("Piston2D", 2.0f);
	//STOP PISTON QUIETER SOUND
	PlaySoundAtEntity("Piston2DQuieter", "factory_piston_2D_quieter.snt", "Player", 1.0f, true);
	
	//STOP PISTON SOUNDS
	StopSound("Piston1Piston", 4.0f);
	StopSound("Piston2Piston", 4.0f);
	StopSound("Piston3Piston", 4.0f);
	
	//DEBUG MESSAGE
	AddDebugMessage("Start Piston Quieter Sound", true);
	}
//BREAK
	if (asChild == "soundopt_pistonquieter_stop")
	{
	//REMOVE STOP TRIGGERS
	RemoveEntityCollideCallback("Player", "soundopt_pistonquieter_stop");
	
	//ADD START TRIGGERS
	AddEntityCollideCallback("Player", "soundopt_pistonquieter_start", "soundopt", true, 1);
	
	//STOP PISTON QUIETER SOUND
	StopSound("Piston2DQuieter", 5.0f);
	//START PISTON LOUD SOUND
	PlaySoundAtEntity("Piston2D", "factory_piston_2D.snt", "Player", 5.0f, true);
	
	//START PISTON SOUNDS
	PlaySoundAtEntity("Piston1Piston", "factory_piston_piston_pers_3D.snt", "factory_pistons_1_piston_source", 4.0f, true);
	PlaySoundAtEntity("Piston2Piston", "factory_piston_piston_pers_3D_2.snt", "factory_pistons_2_piston_source", 4.0f, true);
	PlaySoundAtEntity("Piston3Piston", "factory_piston_piston_pers_3D_3.snt", "factory_pistons_3_piston_source", 4.0f, true);
	
	//DEBUG MESSAGE
	AddDebugMessage("Start Piston Louder Sound", true);
	}
//BREAK

//SOUND PRELOADS
//TREMOR 1
	if (asChild == "soundopt_pistontremor_preload")
	{	
	//DEBUG MESSAGE
	//AddDebugMessage("PISTON TREMOR PRELOADED", true);
	}
}

//PISTON OPTIMSATIONS
void PistonStartSoundOptimisations (string &in asTimer)
{
	//LOCO SOUNDS//
	StopSound("LocoSound_1", 0.0f);
	StopSound("LocoSound3D_2", 0.0f);
	StopSound("LocoSound2D_2", 0.0f);
	StopSound("LocoSound3D_3", 0.0f);
	StopSound("LocoSound2D_3", 0.0f);
	StopSound("LocoSound3D_4", 0.0f);
	StopSound("LocoSound3D_5", 0.0f);
	StopSound("LocoSound2D_5", 0.0f);
	StopSound("LocoSound3D_6", 0.0f);
	StopSound("LocoSound2D_6", 0.0f);
	StopSound("LocoSound3D_7", 0.0f);
	StopSound("LocoSound2D_7", 0.0f);
	StopSound("LocoSound3D_8", 0.0f);
	StopSound("LocoSound2D_8", 0.0f);
	//RAND SOUND TIMERS//
	RemoveTimer("RandOfficeSoundSource_1");
	RemoveTimer("RandOfficeSoundSource_2");
	RemoveTimer("RandOfficeSoundSource_3");
	RemoveTimer("RandOfficeSoundSource_4");
	RemoveTimer("RandOfficeSoundSource_5");
	//PISTON ENV
	RemoveEntityCollideCallback("Player", "soundopt_pistonenv_stop_1");
	RemoveEntityCollideCallback("Player", "soundopt_pistonenv_stop_2");
	RemoveEntityCollideCallback("Player", "soundopt_pistonenv_stop_3");
	RemoveEntityCollideCallback("Player", "soundopt_pistonenv_start_1");
	RemoveEntityCollideCallback("Player", "soundopt_pistonenv_start_2");
	RemoveEntityCollideCallback("Player", "soundopt_pistonenv_start_3");
	RemoveTimer("Player");
	RemoveTimer("InitRandomPistonSoundCuePlayer");
	RemoveTimer("RandPistonSoundCues");
	StopSound("Steam", 1.0f);
	StopSound("Clock", 1.0f);
	
	//DEBUG MESSAGE
	AddDebugMessage("Sound Optimisation Triggered", true);
}
//END SOUND OPTIMSATIONS

//RANDOMISED SOUND CUE PLAYER//
void RandPistonSoundCues(string &in asTimer)
{
	string sCueSource = "Player";
	asTimer = sCueSource;
	PlaySoundAtEntity(asTimer, "afx_spooky_factory_pistonroom.snt", asTimer, 0, false);
	AddDebugMessage("Random Sound Cue Function Selected Piston Room Sound: "+asTimer, false);
	AddTimer(asTimer, RandFloat(20.0f, 30.0f), "RandPistonSoundCues");
}

void RandEnvSoundCues(string &in asTimer)
{
	string[] sCueSources = {"Player"};
	asTimer = sCueSources[0];
	PlaySoundAtEntity(asTimer, "afx_spooky_env_metal.snt", asTimer, 0, false);
	AddDebugMessage("Random Sound Cue Function Selected Env Sound Source: "+asTimer, false);
	AddTimer(asTimer, RandFloat(20.0f, 30.0f), "RandEnvSoundCues");
}

void RandWindSoundCues(string &in asTimer)
{
	string[] sCueSources = {"Player"};
	asTimer = sCueSources[0];
	PlaySoundAtEntity(asTimer, "afx_events_mansion_wind.snt", asTimer, 0, false);
	AddDebugMessage("Random Sound Cue Function Selected Wind Sound Source: "+asTimer, false);
	AddTimer(asTimer, RandFloat(10.0f, 15.0f), "RandWindSoundCues");
}

void RandCourtyardSoundCues(string &in asTimer)
{
	string[] sCueSources = {"CourtyardSource_1", "CourtyardSource_2", "CourtyardSource_3", 
							"CourtyardSource_4", "CourtyardSource_5"};
	asTimer = sCueSources[RandInt (0, 4)];
	PlaySoundAtEntity(asTimer, "afx_spooky_hifrequencymoan.snt", asTimer, 0, false);
	AddDebugMessage("Random Sound Cue Function Selected Office Sound Source: "+asTimer, false);
	if (GetLocalVarInt("AdaptedAmbience") == 0)
	{
		AddTimer(asTimer, RandFloat(5.0f, 15.0f), "RandCourtyardSoundCues");
	}
}
//END RANDOM SOUND CUE PLAYER//

//MANDUS REACTION SOUND PLAYER//
void MandusReactionPlayer (string asReactType, float afWaitTime)
{
	SetLocalVarString("CurrentReactType", asReactType);
	AddTimer("MandusReactionInternalTimer", afWaitTime, "MandusReactionPlayerTimerEnd");
}

void MandusReactionPlayerTimerEnd (string &in asTimer)
{
	if (GetLocalVarString("CurrentReactType") == "Scared")
	{
		AddDebugMessage("SCARED REACTION", false);
		PlaySoundAtEntity("React_Scared", "react_scare.snt", "Player", 0.0f, false);
		return;
	}
	else if (GetLocalVarString("CurrentReactType") == "Breath")
	{
		AddDebugMessage("BREATH REACTION", false);
		PlaySoundAtEntity("React_Breath", "react_breath.snt", "Player", 0.0f, false);
		return;
	}
	else if (GetLocalVarString("CurrentReactType") == "Quick")
	{
		AddDebugMessage("QUICK SCARE REACTION", false);
		PlaySoundAtEntity("React_Quick", "react_quickscare.snt", "Player", 0.0f, false);
		return;
	}
	else if (GetLocalVarString("CurrentReactType") == "Cough")
	{
		AddDebugMessage("COUGH REACTION", false);
		PlaySoundAtEntity("", "react_cough.snt", "Player", 0.0f, false);
		return;
	}
}
//END MANDUS REACTION SOUND PLAYER//

//PHONAUTOGRAPH HANDLER//
void PhonautographHandler (string &in asEntity, int alState)																//This function must be present for all maps containing Phonautograph entities.
{
	if (alState == 1)																										//DO NOT EDIT
	{																														///////////////////////////START OF IF CASE FOR DUPLICATING TO OTHER PHONAUTOGRAPH INSTANCES////////////////////////////////////
		if (asEntity == "Phonautograph1")																					
		{
			SetEntityInteractionDisabled(asEntity, true);																	//DO NOT EDIT
			PlayPropAnimation("Phonautograph1", "Play", 1.0f, true, "");													//Starts Animation. The name of the Phonautograph entity will need changing for other instances.
			AddEffectVoice6("vo_factory_phono_01.ogg", "", "Voice", "vo_factory_phono_mandus_01", 0.0f, "vo_factory_phono_mandus_01_02", 8.0f, "vo_factory_phono_prof_01", 19.0f, "vo_factory_phono_prof_01_02", 27.2f, "vo_factory_phono_mandus_02", 33.5f, "vo_factory_phono_mandus_02_01", 45.25f, false, "", 0.0f, 0.0f);	//Plays voice. The .ogg file being called, and the entry name from the .lang file will need changing for other instances.
			AddTimer("Phono1Timer", 53.5f, "PhonautographDeactivateHandler");	
		}																													
	}																														//////////////////////////END OF IF CASE FOR DUPLICATING TO OTHER PHONAUTOGRAPH INSTANCES///////////////	
}

void PhonautographDeactivateHandler (string &in asTimer)																	//This function must be present for all maps containing Phonautograph entities.
{																															///////////////////////////START OF IF CASE FOR DUPLICATING TO OTHER PHONAUTOGRAPH INSTANCES////////////
	if (asTimer == "Phono1Timer")																							//This if statement must be updated for each different phonautograph instance.
	{
		PlayPropAnimation("Phonautograph1", "Stop", 1.0f, true, "");														//Stops Animation. The name of the Phonautograph entity will need changing for other instances.
	}
}	
//END PHONAUTOGRAPH HANDLER//

//MUSIC PLAYER//
void MusicPlayer (string &in asParent, string &in asChild, int alState)
{
	if (asChild == "yard_music_trigger")
	{
		PlayMusic("music_tesla_1_factory.ogg", false, 0.8f, 2.0f, 0, false);
		return;
	}
	else if (asChild == "entry_music_trigger")
	{
		PlayMusic("music_cellar_children_walkway.ogg", false, 1.0f, 2.0f, 0, false);
		return;
	}
	else if (asChild == "middle_floor_music_trigger")
	{
		PlayMusic("music_bilge_ambience_01.ogg", false, 0.5f, 20.0f, 6, true);
		AddDebugMessage("music playing", false);
		return;
	}
	else if (asChild == "belowpistons_music_trigger")
	{
		PlayMusic("music_sewer_ambient_02.ogg", false, 0.7f, 2.0f, 6, false);
		RemoveTimer("MonsterGenerator3CurrentTimerName");
		SetLocalVarInt("MonsterGenerator3On", 0);
		return;
	}
}	

//END MUSIC PLAYER//

// HINT HANDLER//
void HintHandler (string &in asParent, string &in asChild, int alState)
{
	if (asChild == "FactoryHintTrigger")
	{
		AddHint("Factory1", "");
		return;
	}
	else if (asChild == "FurnacesHintTrigger")
	{
		AddHint("Factory2", "");
	}
}
//END HINT HANDLER//

//----------------------------
//ENCOUNTER HELPERS//
//----------------------------

//-------------------------------------------

void LanternFlicker(float afTime)
{
	SetLanternFlickerActive(true);
	
	AddTimer("LanternFlickerOff", afTime, "TimerLanternFlickerOff");
}

void TimerLanternFlickerOff(string &in asTimer)
{
	SetLanternFlickerActive(false);
}

//-------------------------------------------

void StartLampFlicker(string &in asLamp)
{
	AddTimer(asLamp, RandFloat(0.0f, 0.3f), "TimerLampFlickerOff");
}

void StopLampFlicker(string &in asLamp)
{
	RemoveTimer(asLamp);
	SetLampLit(asLamp, true, false);
}

void StartLampFlickerBurst(string &in asLamp, float afTime)
{
	StartLampFlicker(asLamp);
	AddTimer(asLamp, afTime, "TimerLampFlickerStop");
}

void TimerLampFlickerOff(string &in asLamp)
{
	SetLampLit(asLamp, false, false);
	AddTimer(asLamp, RandFloat(0.1f, 0.2f), "TimerLampFlickerOn");
}

void TimerLampFlickerOn(string &in asLamp)
{
	SetLampLit(asLamp, true, false);
	AddTimer(asLamp, RandFloat(0.05f, 0.15f), "TimerLampFlickerOff");
	
	PlaySoundAtEntity(asLamp+"_flick", "tesla_pig_light_flicker.snt", asLamp, 0, false);
	//*InsertSoundHere*: Sound that fits with the lamps in this level, make sure there is a pretty good distance to the sound
}

void TimerLampFlickerStop(string &in asLamp)
{
	StopLampFlicker(asLamp);
}

