			SetLocalVarFloat("fogOutsideB", 0.073);
			SetLocalVarFloat("fogOutsideStart", -20);//-25);
			SetLocalVarFloat("fogOutsideEnd", 400);
			SetLocalVarFloat("fogOutsideExp", 0.3);//0.2);
