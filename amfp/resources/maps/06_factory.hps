}

void TruckDrivebyTimer (string &in asTimer)
{
	AddDebugMessage("Truck Triggered", false);
	PlayPropAnimation("truck_driveby", "drive", 0.0f, false, "");
	PlaySoundAtEntity("Truckby2", "factory_event_truckby_source1.snt", "TruckSoundSource_2", 0.0f, false);
	PlaySoundAtEntity("Truckby3", "factory_event_truckby_source2.snt", "TruckSoundSource_3", 0.0f, false);
	PlaySoundAtEntity("TruckFire", "factory_event_truckby_backfire.snt", "TruckSoundSource_2D", 0.0f, false);
	PlaySoundAtEntity("Truckby2D", "factory_event_truckby_source_2D.snt", "TruckSoundSource_2D", 0.0f, false);
	PlaySoundAtEntity("TruckbyRattle", "factory_event_truckby_rattle.snt", "TruckSoundSource_2D", 0.0f, false);
	AddTimer("TruckScreenShake", 6.5f, "TruckScreenShake");
	AddTimer("TruckScreenShakeDisappear", 6.8f, "TruckScreenShakeDisappear");
}

