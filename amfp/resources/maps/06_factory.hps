void AwayFromPigs(string &in asParent, string &in asChild, int alState)
{
	AddDebugMessage("Away from pigs", false);
	SetEntityActive("wretch_*", false);
	PlaySoundAtEntity("aarrw", "wretch_tunnels_amb_alert.snt", "AreaPigSayYeYe", 2, false);
	
	AddHint("Factory4", "");
}

//----------------------------------

void ColllidePigToggle(string &in asParent, string &in asChild, int alState)
{
	if(alState == 1)
	{
		SetEnemyDisableTriggers("wretch_*", true);
		PlayEnemyAnimation("wretch_*", "ThreatLoopQuadruped", false, 1);
		AddTimer("goingplaces", 5, "TimerGoingToSkurup");
		
	}
	else
	{
		RemoveTimer("goingplaces");
		SetEnemyDisableTriggers("wretch_*", false);
	}
}

void TimerGoingToSkurup(string &in asTimer)
{
	AddEnemyPatrolNode("wretch_*", "PathNodeArea_13", 5, "", false);
}

//----------------------------------

void CheckpointBottom(string &in asName, int alCount)
{
	//////////////////////////////////
	// Make sure all callbacks are removed
	RemoveEntityCollideCallback("Player", "AreaPig3Start");
	RemoveEntityCollideCallback("Player", "AreaPig4Start");
	RemoveEntityCollideCallback("Player", "AreaPig5Start");
	RemoveEntityCollideCallback("Player", "AreaPig6Start");	
	RemoveEntityCollideCallback("Player", "AreaFakeEnc1");
	RemoveEntityCollideCallback("Player", "AreaFakeEnc2");
	
	//////////////////////////////////
	// Add these again at random.
	RemoveEntityCollideCallback("Player", "AreaPig3Start");
	RemoveEntityCollideCallback("Player", "AreaPig4Start");
	RemoveEntityCollideCallback("Player", "AreaPig5Start");
	RemoveEntityCollideCallback("Player", "AreaPig6Start");	
	RemoveEntityCollideCallback("Player", "AreaFakeEnc1");
	RemoveEntityCollideCallback("Player", "AreaFakeEnc2");
	
	//////////////////////////////////
	// Setup player
	SetPlayerCrouching(true);
	

	//////////////////////////////////
	// Add these again at random.
	if(alCount<=2)
	{
		SetLocalVarInt("PigActive", 0);
	
		if(RandInt(1,2)==1) AddEntityCollideCallback("Player", "AreaPig4Start", "EnterPig4Start", true, 1);
		if(RandInt(1,2)==1) AddEntityCollideCallback("Player", "AreaPig5Start", "EnterPig5Start", true, 1);
		if(RandInt(1,2)==1) AddEntityCollideCallback("Player", "AreaPig6Start", "EnterPig6Start", true, 1);	
	
		if(RandInt(1,2)==1) AddEntityCollideCallback("Player", "AreaFakeEnc1", "EnterFakeEnc1", true, 1);
		if(RandInt(1,2)==1) AddEntityCollideCallback("Player", "AreaFakeEnc2", "EnterFakeEnc2", true, 1);
		
		//Throw in a stalking one for extra tension, (this one runs off if spotting player)
		SetEntityActive("wretch_7", true);
	}
	//////////////////////////////////
	// Only add the fake ones
	{
		AddEntityCollideCallback("Player", "AreaFakeEnc1", "EnterFakeEnc1", true, 1);
		AddEntityCollideCallback("Player", "AreaFakeEnc2", "EnterFakeEnc2", true, 1);
	}
}

//----------------------------------

void BottomPigDisabled(string &in asEntity, string &in asType)
{
	SetLocalVarInt("PigActive", 0);
}

