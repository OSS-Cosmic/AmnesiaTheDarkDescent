//DEFINE COAL ARRAYS//
array <string> sFurnace2Contents;
array <string> sFurnace3Contents;
array <string> sFurnace6Contents;
array <string> sCoalToIgniteOnLoad;
//LOAD COAL ARRAYS BEFORE LEVEL LOAD//
array<string> LoadStringArray(string &in arrayName)
{
    array<string> newArray;

	int lStoredArraySize = GetGlobalVarInt("arr_" + arrayName + "length");

	for ( int i = 0; i < lStoredArraySize; i++ )
	{
	    newArray.insertLast( GetGlobalVarString( "arr_" + arrayName + "_elem_" + i ) );
	}

	return newArray;
}
//END LOAD COAL ARRAYS//

//SAVE COAL ARRAYS TO GLOBAL VAR FOR STORAGE DURING SAVE/RELOAD//
void SaveStringArray( string &in arrayName, array<string> &in arrayInstance )
{
    int lStoredArraySize = GetGlobalVarInt( "arr_" + arrayName + "length" );

	SetGlobalVarInt( "arr_" + arrayName + "length", arrayInstance.length() );

	for ( int i = 0; i < arrayInstance.length(); i++ )
	{
	    SetGlobalVarString( "arr_" + arrayName + "_elem_" + i, arrayInstance[ i ] );
	}
}
//END SAVE ARRAYS//									

void OnStart()
 
{
	//Map Preamble
	{
		SetMapDisplayNameEntry("Factory");
		//SET CHECKPOINT #1//
		CheckPoint("CP01_Start", "MainStart", "", "", "", false);
		//CLEAR OLD HINTS//
		//RemoveAllHints();
	}
	//END LEVEL TRANSITION MUSIC
	{
		StopMusic(5.0f, 8);
	}
	
	// Setup Local Variables
