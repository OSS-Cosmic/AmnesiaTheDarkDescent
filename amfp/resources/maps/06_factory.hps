{
	AddDebugMessage("Pig Attack Music Sting", false);
	AddEntityCollideCallback("Player", "Wretch1TriggerSound", "Wretch1TriggerSound", true, 0);
	PlayMusic("music_factory_pigattack_post.ogg", false, 0.85f, 1.0f, 8, false);
}
