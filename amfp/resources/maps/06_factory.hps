//ENV SOUNDS//
void RandomEnvSound (string &in asParent, string &in asChild, int alState)
{
	if (asChild == "EnvSoundsStart_1"|| asChild == "EnvSoundsStart_2"|| asChild == "EnvSoundsStart_3")
	{	
	
		//START ENV
		AddTimer("InitRandomEnvSoundCuePlayer", 10.0f, "RandEnvSoundCues");
		
		//AREAS
		RemoveEntityCollideCallback("Player", "EnvSoundsStart_1");
		RemoveEntityCollideCallback("Player", "EnvSoundsStart_2");
		RemoveEntityCollideCallback("Player", "EnvSoundsStart_3");
		AddEntityCollideCallback("Player", "EnvSoundsStop_1", "RandomEnvSound", true, 1);
		AddEntityCollideCallback("Player", "EnvSoundsStop_2", "RandomEnvSound", true, 1);
		AddEntityCollideCallback("Player", "EnvSoundsStop_3", "RandomEnvSound", true, 1);
		
		AddDebugMessage("ENV SOUNDS START!", true);
	return;
	}
	
	else if (asChild == "EnvSoundsStop_1"|| asChild == "EnvSoundsStop_2"|| asChild == "EnvSoundsStop_3")
	{
		//REMOVE OUTSIDE SOUND
		RemoveTimer("Player");
		RemoveTimer("RandEnvSoundCues");
		RemoveTimer("InitRandomEnvSoundCuePlayer");
			
		//AREAS
		RemoveEntityCollideCallback("Player", "EnvSoundsStop_1");
		RemoveEntityCollideCallback("Player", "EnvSoundsStop_2");
		RemoveEntityCollideCallback("Player", "EnvSoundsStop_3");
		AddEntityCollideCallback("Player", "EnvSoundsStart_1", "RandomEnvSound", true, 1);
		AddEntityCollideCallback("Player", "EnvSoundsStart_1", "RandomEnvSound", true, 1);
		AddEntityCollideCallback("Player", "EnvSoundsStart_1", "RandomEnvSound", true, 1);

				
		AddDebugMessage("ENV SOUNDS STOP!", true);
		return;
	}										
}
//END ENV SOUNDS//


