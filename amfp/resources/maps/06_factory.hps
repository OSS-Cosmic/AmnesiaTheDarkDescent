			SetEntityConnectionStateChangeCallback("Lever2", "PistonLeverHandler");
			SetEntityConnectionStateChangeCallback("Lever3", "PistonLeverHandler");
			
			SetMoveObjectState("Gatex", 0.5f);
			
			//DOWNSTAIRS CHILD
			AddEntityCollideCallback("child_1", "ChildBottomAreaKillTrigger", "ChildEventHandler", true, 1);
			AddEntityCollideCallback("child_2", "ChildBottomAreaKillTrigger", "ChildEventHandler", true, 1);
			AddEntityCollideCallback("Player", "ChildSpawnTrigger", "ChildEventHandler", true, 1);
			AddEntityCollideCallback("Player", "ChildRunTrigger", "ChildEventHandler", true, 1);
			SetEntityActive("child_1", false);
			SetEntityActive("child_2", false);
			
			
			AddEntityCollideCallback("Player", "AreaPigSayYeYe", "ColllidePigToggle", false, 0);
