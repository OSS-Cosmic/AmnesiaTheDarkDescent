			AddEntityCollideCallback("Player", "EnvSoundsStart_3", "RandomEnvSound", true, 1);
			
			//FURNACE DOORS//
			AddEntityCollideCallback("Furnace2Door", "Furnace2DoorCollider", "FurnaceDoorEventHandler", false, 1);
			AddEntityCollideCallback("Furnace3Door", "Furnace3DoorCollider", "FurnaceDoorEventHandler", false, 1);
			AddEntityCollideCallback("Furnace6Door", "Furnace6DoorCollider", "FurnaceDoorEventHandler", false, 1);
			
			//LOOKAT CALLBACKS//
			SetEntityPlayerLookAtCallback("PistonResetFailSafeLookTarget", "PistonResetFailSafeUpdater", false);
			
