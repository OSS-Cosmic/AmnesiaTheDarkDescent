//MAP SOUND CHANNEL MANAGER//

//GATE 2 DROP//
void Gate2Drop (string &in asParent, string &in asChild, int alState)
{
	SetLampLit("bonfire_factory_tank_large_6", false, false);
	SetLampLit("Furnace2Lamp", false, false);
	SetLampLit("bonfire_factory_tank_large_8", false, false);
	SetLampLit("Furnace3Lamp", false, false);
	SetLampLit("bonfire_factory_tank_large_4", false, false);
	SetLampLit("Furnace6Lamp", false, false);
	SetSwingDoorClosed("engineroom_office_door_2", true, false);
	
	SetMoveObjectState("Gate2", 0.0f);
	SetParticleSystemActive("BrokenGateSparks*", false);
	AddTimer("Gate2DropTimer", 0.7f, "Gate2DropTimedParticles");
	StopSound("GateSparkLoop", 0.1f);
	PlaySoundAtEntity("Drag", "afx_event_factory_gate_close", "Gate2", 0.0f, false);
	RemoveTimer("MonsterGenerator1CurrentTimerName");
	RemoveTimer("MonsterGenerator2CurrentTimerName");
	SetLocalVarInt("MonsterGenerator1On", 0);
	SetLocalVarInt("MonsterGenerator2On", 0);
	SetLocalVarInt("MonsterGenerator3On", 1);
	AddTimer("VoidTimer", 1.5f, "RandPigFloor3SoundCues");
	CheckPoint("CP03_BottomFloor", "CheckpointStart_2", "DeathHandler", "", "", true);
}

void Gate2DropTimedParticles (string &in asTimer)
{
	SetParticleSystemActive("BrokenGateDust*", true);
}
//END GATE 2 DROP//									

void AreaCloseGateX(string &in asParent, string &in asChild, int alState)
{
	StartScreenShake(0.02, 1, 1, 1);
	PlaySoundAtEntity("Rumble", "afx_sewer_pipetremor_01.snt", "Player", 0, false);

	AddTimer("gate_move", 1.2, "TimerStopRumb");
	AddTimer("gate_down", 1.9, "TimerStopRumb");
	AddTimer("stop", 2.5, "TimerStopRumb");
}

void TimerStopRumb(string &in asTimer)
{
	if(asTimer == "gate_move")
	{
		PlaySoundAtEntity("roll", "roll_metal.snt", "Gatex", 0.2, false);
		PlaySoundAtEntity("scrape", "loco_iron_door_open.snt", "Gatex", 0.2, false);
		SetMoveObjectState("Gatex", 0.0f);
		return;
	}
	if(asTimer == "gate_down")
	{
		StopSound("roll", 0.1f);
		StopSound("scrape", 0.1f);
		PlaySoundAtEntity("down", "impact_metal_high.snt", "Gatex", 0, false);
		PlaySoundAtEntity("down2", "loco_iron_door_close_2D.snt", "Gatex", 0.8, false);
		return;
	}
	
	StopSound("Rumble", 3);
}
//AMBIENCE REMOVAL// //REMOVE OUT OF RANGE AMBIENCE TO MAKE SOUND CHANNELS AVAILABLE FOR PIG//
void AdaptedAmbience() 
{
	//START SHED DOOR WIND SAMPLE//
	RemoveEntityCollideCallback("SecretExitDoor", "SecretDoorWindSampleCollider");
	//FACTORY ENTRANCE DOOR WIND SAMPLE//
	RemoveEntityCollideCallback("FactoryFrontDoor", "FactoryFrontDoorWindCollider");
	//RANDOM FX TRIGGERS//
	RemoveEntityCollideCallback("Player", "FactorySoundStart");
}	
//END AMBIENCE REMOVAL//							
//END MAP SOUND CHANNEL MANAGER//									
				
//PHONE HANDLERS//
void FactoryPhone (string &in asParent, string &in asChild, int alState)
{
	AddTimer("FactoryPhoneRinging", RandFloat(1.8f, 3.2f), "FactoryPhoneTimerCall");
	RemoveTimer("FactoryTruckTimerPhone");
}

void FactoryTruckTimerPhone (string &in asTimer)
{
	AddTimer("FactoryPhoneRinging", RandFloat(1.8f, 3.2f), "FactoryPhoneTimerCall");
	RemoveEntityCollideCallback("Player", "PhoneTrigger");
}

void FactoryPhoneTimerCall (string &in asTimer)
{
	RemoveTimer("FactoryTruckTimerPhone");
	RemoveEntityCollideCallback("Player", "PhoneTrigger");
	AddDebugMessage("Phone Ringing - Timer Begin", false);
	StartPhoneRinging("phone_box_2");
	SetLampLit("phone_box_3", true, true);
	AddTimer ("PhoneTimeout", 30.0f,  "PhoneTimeout");
	AddEntityCollideCallback("Player", "Sound_PigAttack_Trigger", "PigAttackSound", true, 0);
	SetEntityPlayerInteractCallback("phone_box_2", "InteractPhoneBox", true);
}

void PhoneTimeout (string &in asTimer)
{
	AddDebugMessage("Phone Stopped Ringing", false);
	StopPhoneRinging("phone_box_2");
	SetLampLit("phone_box_3", false, true);
	AddEntityCollideCallback("Player", "Sound_PigAttack_Trigger", "PigAttackSound", true, 0);
	SetEntityPlayerInteractCallback("phone_box_2", "", false);
}

void InteractPhoneBox (string &in asEntity)
{
	RemoveTimer("PhoneTimeout");
	
	AddTimer("PhoneCallTimer", 18.75, "PhoneCallOver");
	StopSound("phone_box_2_AnimEvent", 0.1f);
	
	// Handle mask2 spawn
	if (GetLocalVarInt("Mask2MaySpawn") == 1)
	{
		SetEntityActive("Mask2", true);
		SetEntityActive("Mask2Nail", true);
		SetLocalVarInt("Mask2Active", 1);
		SetPropStaticPhysics("Mask2", true);
		SetPropStaticPhysics("Mask2Nail", true);
		AddEntityCollideCallback("Player", "Mask2DespawnTrigger", "Mask2Despawner", true, 1);
	}
}

void PhoneCallOver (string &in asTimer)
{
	SetLampLit("phone_box_3", false, true);
}
//END PHONE RINGING//	

