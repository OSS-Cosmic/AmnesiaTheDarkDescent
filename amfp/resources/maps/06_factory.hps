//AMBIENT SOUNDTRACK PLAYER//
void MapAmbienceAreas (string &in asParent, string &in asChild, int alState) //Callback function for all ambience areas in map
{
	if (asChild == "AMBStart")
	{
		if (alState == 1)
		{
			PlaySoundAtEntity("AMBStart", "amb_church_pens.snt", "Player", 1.0f, true);
			SetLocalVarString("CurrentAmbientTrack", asChild);
			return;
		}
		else if (alState == -1) 
		{
			StopSound("AMBStart", 1.0f);
			return;
		}
	}
//BREAK//
	if (asChild == "AMBShed")
	{
		if (alState == 1)
		{
			PlaySoundAtEntity("AMBShed", "amb_church_alley_loadingarea_small.snt", "Player", 1.0f, true);
			SetLocalVarString("CurrentAmbientTrack", asChild);
			return;
		}
		else if (alState == -1) 
		{
			StopSound("AMBShed", 1.0f);
			return;
		}
	}
//BREAK//
	if (asChild == "AMBPistonRoom")
	{
		if (alState == 1)
		{
			PlaySoundAtEntity("AMBPistonRoom", "amb_factory_piston_room_drone.snt", "Player", 1.0f, true);
			SetLocalVarString("CurrentAmbientTrack", asChild);
			return;
		}
		else if (alState == -1) 
		{
			StopSound("AMBPistonRoom", 1.0f);
			return;
		}
	}
//BREAK//
	if (asChild == "AMBPistonUnder")
	{
		if (alState == 1)
		{
			PlaySoundAtEntity("AMBPistonUnder", "amb_factory_piston_room_under_drone.snt", "Player", 1.0f, true);
			SetLocalVarString("CurrentAmbientTrack", asChild);
			return;
		}
		else if (alState == -1) 
		{
			StopSound("AMBPistonUnder", 1.0f);
			return;
		}
	}
//BREAK//
	if (asChild == "AMBOutside")
	{
		if (alState == 1)
		{
			PlaySoundAtEntity("AMBOutside", "amb_mansion_mansion_drone_courtyard.snt", "Player", 1.0f, true);
			SetLocalVarString("CurrentAmbientTrack", asChild);
			return;
		}
		else if (alState == -1) 
		{
			StopSound("AMBOutside", 1.0f);
			return;
		}
	}
//BREAK//
}
//END AMBIENT SOUNDTRACK PLAYER//

//TRIGGERED VO PLAYER//
void VOPlayer (string &in asParent, string &in asChild, int alState)
{
	if (asChild == "vo_yard_flashback_trigger")
	{
		AddEffectVoice2("vo_factory_mandus_flashback_01", "", "Voice", "vo_factory_mandus_flashback_01_01", 0.0f, "vo_factory_mandus_flashback_01_02", 6.3f, false, "", 0.0f, 0.0f);
		PlaySoundAtEntity("", "afx_gameplay_hightone_10sec.snt", "Player", 1.0f, false);
		PlaySoundAtEntity("", "afx_flashback_whisper.snt", "Player", 1.0f, false);	
		FadeImageTrailTo(2.0f, 2.5f);
		SetPlayerMoveSpeedMul(0.35f);
		SetPlayerLookSpeedMul(0.35f);
		AddTimer("ReturnToNormal", 9.5f, "RestoreToNormal");
		return;
	}
}
