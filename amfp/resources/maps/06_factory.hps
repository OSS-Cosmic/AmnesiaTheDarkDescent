	AddDebugMessage("Pig You So Nasty", false);
	PlaySoundAtEntity("Attack", "afx_event_factory_pigstory_07", "Player", 0.0f, false);
	AddTimer("PostPigAttackMusicTimer", 13.0f, "PostPigAttackMusicTimer");
}

