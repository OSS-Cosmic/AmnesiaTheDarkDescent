	{
	//COURTYARD
	AddEntityCollideCallback("Player", "soundopt_courtyard_start_1", "soundopt", true, 1);
	AddEntityCollideCallback("Player", "soundopt_courtyard_start_2", "soundopt", true, 1);
	//PISTON ROOM ENV
	AddEntityCollideCallback("Player", "soundopt_pistonenv_start_1", "soundopt", true, 1);
	AddEntityCollideCallback("Player", "soundopt_pistonenv_start_2", "soundopt", true, 1);
	AddEntityCollideCallback("Player", "soundopt_pistonenv_start_3", "soundopt", true, 1);
	//QUIETER PISTON SOUND
	AddEntityCollideCallback("Player", "soundopt_pistonquieter_start", "soundopt", true, 1);
	
	//PRELOADS
	//PISTON TREMOR
	AddEntityCollideCallback("Player", "soundopt_pistontremor_preload", "soundopt", true, 1);
	}
	//END SOUND OPTIMSATIONS
	
	//INITIALISE LAST PLAYING AMBIENCE//
	{
		string sAmbienceToRestart = GetLocalVarString("CurrentAmbientTrack");
		MapAmbienceAreas("Player", sAmbienceToRestart, 1);
	}
	
	//LIGHT STATES//
	{
		//FURNACE COAL LIGHTS//
		if (GetLocalVarInt("Furnace2Lit") == 0)
		{
			SetLampFlickerActive("Furnace2Lamp", false);
			SetLampLit("Furnace2Lamp", false, false);
		}
		else
		{
			SetLampFlickerActive("Furnace2Lamp", true);
			SetLampLit("Furnace2Lamp", true, false);
		}
		if (GetLocalVarInt("Furnace3Lit") == 0)
		{
			SetLampFlickerActive("Furnace3Lamp", false);
			SetLampLit("Furnace3Lamp", false, false);
		}
		else
		{
			SetLampFlickerActive("Furnace3Lamp", true);
			SetLampLit("Furnace3Lamp", true, false);
		}
		if (GetLocalVarInt("Furnace6Lit") == 0)
		{
			SetLampFlickerActive("Furnace6Lamp", false);
			SetLampLit("Furnace6Lamp", false, false);
		}
		else
		{
			SetLampFlickerActive("Furnace6Lamp", true);
			SetLampLit("Furnace6Lamp", true, false);
		}
		//FURNACE SWITCH LIGHTS//
		if (GetLocalVarInt("Furnace2Prepped") == 1)
		{
			SetLightVisible("Furnace2SwitchLight", true);
			SetLightFlickerActive("Furnace2SwitchLight", false);
		}
		else
		{
			SetLightVisible("Furnace2SwitchLight", false);
			SetLightFlickerActive("Furnace2SwitchLight", false);
		}
		if (GetLocalVarInt("Furnace3Prepped") == 1)
		{
			SetLightVisible("Furnace3SwitchLight", true);
			SetLightFlickerActive("Furnace3SwitchLight", false);
		}
		else
		{
			SetLightVisible("Furnace3SwitchLight", false);
			SetLightFlickerActive("Furnace3SwitchLight", false);
		}
		if (GetLocalVarInt("Furnace6Prepped") == 1)
		{
			SetLightVisible("Furnace6SwitchLight", true);
			SetLightFlickerActive("Furnace6SwitchLight", false);
		}
		else
		{
			SetLightVisible("Furnace6SwitchLight", false);
			SetLightFlickerActive("Furnace6SwitchLight", false);
		}
	}

	//SOUND CUES//
	{
		//START AREA & OFFICE SOUNDS//
		if (GetLocalVarInt("SoundCutOff1") == 0)
		{
			PlaySoundAtEntity("Steam", "amb_church_pens_steam_loop_quieter.snt", "PensSteamSource", 0.0f, true);
		}
	
		//FIRE SOUNDS
		PlaySoundAtEntity("FactoryFire3D_1", "amb_factory_machine_fire_3D.snt", "FireSoundSource_1", 0.0f, true);							
		PlaySoundAtEntity("FactoryFire2D_1", "amb_factory_machine_fire_2D.snt", "FireSoundSource_1", 0.0f, true);
		if (GetLocalVarInt("Furnace2Lit") == 1)
		{
			PlaySoundAtEntity("FactoryFire3D_2", "amb_factory_machine_fire_3D.snt", "FireSoundSource_2", 0.0f, true);
			PlaySoundAtEntity("FactoryFire2D_2", "amb_factory_machine_fire_2D.snt", "FireSoundSource_2", 0.0f, true);
		}
		PlaySoundAtEntity("FactoryFire3D_3", "amb_factory_machine_fire_3Dsmallarea.snt", "FireSoundSource_3", 0.0f, true);
		if (GetLocalVarInt("Furnace6Lit") == 1)
		{
			PlaySoundAtEntity("FactoryFire3D_4", "amb_factory_machine_fire_3D.snt", "FireSoundSource_4", 0.0f, true);
			PlaySoundAtEntity("FactoryFire2D_4", "amb_factory_machine_fire_2D.snt", "FireSoundSource_4", 0.0f, true);
		}
		PlaySoundAtEntity("FactoryFire3D_5", "amb_factory_machine_fire_3D.snt", "FireSoundSource_5", 0.0f, true);
		PlaySoundAtEntity("FactoryFire2D_5", "amb_factory_machine_fire_2D.snt", "FireSoundSource_5", 0.0f, true);
		if (GetLocalVarInt("Furnace3Lit") == 1)
		{
			PlaySoundAtEntity("FactoryFire3D_6", "amb_factory_machine_fire_3Dsmallarea.snt", "FireSoundSource_6", 0.0f, true);
