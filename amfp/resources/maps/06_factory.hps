			AddEntityCollideCallback("FactoryFrontDoor", "FactoryFrontDoorWindCollider", "FrontDoorWindSample", false, 0);
			//RANDOM FX TRIGGERS
			AddEntityCollideCallback("Player", "FactorySoundStart", "FactorySoundStart", true, 1);//PISTON ROUND SOUND FX
