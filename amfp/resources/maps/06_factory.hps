//-----------------------------------------------------------

/////////////////////////
// FOG SWITCHER
////////////////////////

//------------------------------------------------------------

// The AreaBeginInside_0..7 boxes are nested, and each one only steps the fog
// one level up on entry and one level down on exit. That relies on the exits
// arriving innermost-first, but the boxes share their x faces, so several
// callbacks can fire in one frame in registration order (0..7) and leave the
// courtyard with the innermost fog. Track which boxes the player is in and
// derive the fog from the deepest one, so the result is order independent.
void CollideBeginInside(string &in asParent, string &in asChild, int alState)
{
	int lArea = -1;
	for(int i=0;i<=7;i++)
		if(asChild == "AreaBeginInside_"+i) lArea = i;
	if(lArea < 0) return;

	int lMask = GetLocalVarInt("FogInsideMask");
	if(alState == 1) lMask |= (1 << lArea);
	else lMask &= ~(1 << lArea);
	SetLocalVarInt("FogInsideMask", lMask);

	int lLevel = -1;
	for(int i=0;i<=7;i++)
		if((lMask & (1 << i)) != 0) lLevel = i;

	//Ordered step: keep the authored transition values
	if((alState == 1 && lLevel == lArea) || (alState == -1 && lLevel == lArea-1))
		FogSwitcherStep(lArea, alState);
	//Out of order: snap to the fog of the deepest box still occupied
	else if(lLevel < 0)
		FogSwitcherStep(0, -1);
	else
		FogSwitcherStep(lLevel, 1);

	SetFogSkyInside(lLevel >= 0);
}

void SetFogSkyInside(bool abInside)
{
	int lInside = abInside ? 1 : 0;
	if(GetLocalVarInt("FogSkyInside") == lInside) return;
	SetLocalVarInt("FogSkyInside", lInside);

	if(abInside)
	{
		float fR = GetLocalVarFloat("fogOutsideR");
		float fG = GetLocalVarFloat("fogOutsideG");
		float fB = GetLocalVarFloat("fogOutsideB");
		SetSkyBoxColor(fR*0.4, fG*0.3, fB*0.1,1);
		SetSkyBoxTexture("");
	}
	else
	{
		SetSkyBoxColor(1, 1, 1, 1);
		SetSkyBoxTexture("de_skybox.dds");
	}
}

void FogSwitcherStep(int alArea, int alState)
{
	string asChild = "AreaBeginInside_"+alArea;
	float fR = GetLocalVarFloat("fogOutsideR");
	float fG = GetLocalVarFloat("fogOutsideG");
	float fB = GetLocalVarFloat("fogOutsideB");
	float fStart = GetLocalVarFloat("fogOutsideStart");
	float fEnd = GetLocalVarFloat("fogOutsideEnd");
	float fExp = GetLocalVarFloat("fogOutsideExp");
	
	if(asChild == "AreaBeginInside_0")
	{
		//Going inside
		if(alState == 1)
		{
			SetFogColor(fR*1.05, fG*0.95, fB*0.8, 1);
			SetFogProperties(fStart*0.9, fEnd*0.8, fExp*1.1, true);
		}
		
		//Outside
		else if(alState == -1)
		{
			SetFogColor(fR, fG, fB, 1);
			SetFogProperties(fStart, fEnd, fExp, false);
		}
	}
	if(asChild == "AreaBeginInside_1")
	{
		//Going inside
		if(alState == 1)
		{
			SetFogColor(fR*1.1, fG*0.9, fB*0.7, 1);
			SetFogProperties(fStart*0.8, fEnd*0.6, fExp*1.2, true);
		}
		
		//Outside
		else if(alState == -1)
		{
			SetFogColor(fR*1.05, fG*0.95, fB*0.8, 1);
			SetFogProperties(fStart*0.9, fEnd*0.8, fExp*1.1, true);
		}		
	}
	if(asChild == "AreaBeginInside_2")
	{
		//Going inside
		if(alState == 1)
		{
			SetFogColor(fR*1.15, fG*0.85, fB*0.65, 1);
			SetFogProperties(fStart*0.7, fEnd*0.4, fExp*1.4, true);
		}
		
		//Outside
		else if(alState == -1)
		{
			SetFogColor(fR*1.1, fG*0.9, fB*0.7, 1);
			SetFogProperties(fStart*0.8, fEnd*0.6, fExp*1.2, true);
		}			
	}
	if(asChild == "AreaBeginInside_3")
	{
		//Going inside
		if(alState == 1)
		{
			SetFogColor(fR*1.2, fG*0.75, fB*0.5, 1);
			SetFogProperties(fStart*0.6, fEnd*0.25, fExp*1.7, true);
		}
		
		//Outside
		else if(alState == -1)
		{
			SetFogColor(fR*1.15, fG*0.85, fB*0.65, 1);
			SetFogProperties(fStart*0.7, fEnd*0.4, fExp*1.4, true);
		}			
	}
	if(asChild == "AreaBeginInside_4")
	{
		//Going inside
		if(alState == 1)
		{
			SetFogColor(fR*1.25, fG*0.65, fB*0.4, 1);
			SetFogProperties(fStart*0.5, fEnd*0.2, fExp*2.1, true);
		}
		
		//Outside
		else if(alState == -1)
		{
			SetFogColor(fR*1.2, fG*0.75, fB*0.5, 1);
			SetFogProperties(fStart*0.6, fEnd*0.25, fExp*1.7, true);
		}			
	}
	if(asChild == "AreaBeginInside_5")
	{
		//Going inside
		if(alState == 1)
		{
			SetFogColor(fR*1.3, fG*0.55, fB*0.29, 1);
			SetFogProperties(fStart*0.4, fEnd*0.15, fExp*2.8, true);
		}
		
		//Outside
		else if(alState == -1)
		{
			SetFogColor(fR*1.25, fG*0.65, fB*0.4, 1);
			SetFogProperties(fStart*0.5, fEnd*0.15, fExp*2.1, true);
		}			
	}
	if(asChild == "AreaBeginInside_6")
	{
		//Going inside
		if(alState == 1)
		{
			SetFogColor(fR*1.35, fG*0.45, fB*0.18, 1);
			SetFogProperties(fStart*0.3, fEnd*0.1, fExp*3.4, true);
		}
		
		//Outside
		else if(alState == -1)
		{
			SetFogColor(fR*1.3, fG*0.55, fB*0.29, 1);
			SetFogProperties(fStart*0.4, fEnd*0.1, fExp*2.8, true);
		}			
	}
	if(asChild == "AreaBeginInside_7")
	{
		//Going inside
		if(alState == 1)
		{
			SetFogColor(fR*1.4, fG*0.35, fB*0.097, 1);
			SetFogProperties(fStart*0.2, fEnd*0.07, fExp*4, true);
		}
		
		//Outside
		else if(alState == -1)
		{
			SetFogColor(fR*1.35, fG*0.45, fB*0.18, 1);
			SetFogProperties(fStart*0.3, fEnd*0.07, fExp*3.8, true);
		}			
	}
}

