			SetMoveObjectState("Gate2", 0.5f);
			SetMoveObjectState("Gate3", 0.75f);
			PlayPropAnimation("electric_cabin_animated_3", "on", 0, true, "");
			PlayPropAnimation("electric_cabin_animated_4", "on", 0, true, "");
			PlayPropAnimation("gauge01_1", "on", 0, true, "");
			PlayPropAnimation("gauge01_2", "on", 0, true, "");
			AddTimer("PistonStartSoundOptimisations", 1.0f, "PistonStartSoundOptimisations");
			SetLampLit("cellar_gaslamp01_F_short_1", false, false);
			SetLampLit("cellar_gaslamp01_F_short_2", false, false);
			SetLampLit("cellar_gaslamp01_F_short_3", false, false);
			SetLampLit("cellar_gaslamp01_F_short_4", false, false);
