//PISTON ANIMATION PADDING CALLS//
void PistonAnimationPadding (string &in asTimer)
{
	if (asTimer == "Piston1AnimationPadding")
	{
		PlayPropAnimation("factory_pistons_1", "on", 0.0f, true, "");
		return;
	}
	else if (asTimer == "Piston2AnimationPadding")
	{
		PlayPropAnimation("factory_pistons_2", "on", 0.0f, true, "");
		return;
	}
	else if (asTimer == "Piston3AnimationPadding")
	{
		PlayPropAnimation("factory_pistons_3", "on", 0.0f, true, "");
		return;
	}
}
//END PISTON ANIMATION PADDING CALLS//

